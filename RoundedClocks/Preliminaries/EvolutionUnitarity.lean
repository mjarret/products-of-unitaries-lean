module

public import RoundedClocks.Citations

/-! # Unitarity of Schrödinger evolutions

The evolution existence result differentiates `V†V` and uses its initial value to show that every
solution generated by a Hermitian family is unitary.
-/

@[expose] public section

open scoped Matrix.Norms.L2Operator Topology Real
open Set Filter
open Complex (I)

noncomputable section

namespace RoundedClocks

variable {d : ℕ}

local notation "𝕄" => Matrix (Fin d) (Fin d) ℂ

/-- A Hermitian Schrödinger solution is unitary by uniqueness of the equation for V†V. -/
theorem generates_of_cited_linear_solution
    (dieudonne_10_5_4 : Dieudonne_10_5_4)
    {G V : ℝ → 𝕄} {a b : ℝ} (hab : a ≤ b)
    (hG : IsHermitianFamily G a b)
    (hV : SolvesLinearMatrixODE (fun t ↦ -I • G t) (fun _ ↦ 0)
      1 V a a b) : Generates G V a b := by
  obtain ⟨hVc, hVa, S, hS, hVd⟩ := hV
  have hderiv (t : ℝ) (ht : t ∈ Icc a b) (htS : t ∉ S) :
      HasDerivWithinAt V (-I • (G t * V t)) (Icc a b) t := by
    simpa only [add_zero, smul_mul_assoc] using hVd t ht htS
  let W : ℝ → 𝕄 := fun t ↦ (V t)† * V t
  have hWc : ContinuousOn W (Icc a b) := hVc.star.mul hVc
  have hWa : W a = 1 := by simp [W, hVa]
  have hWd (t : ℝ) (ht : t ∈ Icc a b) (htS : t ∉ S) :
      HasDerivWithinAt W 0 (Icc a b) t := by
    have hVt := hderiv t ht htS
    have hadjoint : HasDerivWithinAt (fun s ↦ (V s)†)
        (I • ((V t)† * G t)) (Icc a b) t := by
      simpa [show (G t)† = G t from (hG t ht).eq, Complex.star_def] using hVt.star
    have hcancel :
        (I • ((V t)† * G t)) * V t + (V t)† * (-I • (G t * V t)) = 0 := by
      calc
        _ = I • ((V t)† * G t * V t) - I • ((V t)† * G t * V t) := by
          simp only [smul_mul_assoc, mul_smul_comm, mul_assoc, neg_smul, mul_neg,
            sub_eq_add_neg]
        _ = 0 := sub_self _
    simpa only [hcancel] using hadjoint.mul hVt
  have hW : SolvesLinearMatrixODE (fun _ ↦ 0) (fun _ ↦ 0) 1 W a a b := by
    refine ⟨hWc, hWa, S, hS, ?_⟩
    intro t ht htS
    simpa only [zero_mul, zero_add] using hWd t ht htS
  have hOne : SolvesLinearMatrixODE (fun _ ↦ 0) (fun _ ↦ 0)
      (1 : 𝕄) (fun _ ↦ 1) a a b := by
    refine ⟨continuousOn_const, rfl, S, hS, ?_⟩
    intro t _ _
    simpa only [zero_mul, zero_add] using
      (hasDerivWithinAt_const t (Icc a b) (1 : 𝕄))
  have hZero : IsRegulated (fun _ ↦ (0 : 𝕄)) a b := by
    constructor <;> intro t _ <;> exact ⟨0, tendsto_const_nhds⟩
  have hW_eq : EqOn W (fun _ ↦ 1) (Icc a b) :=
    dieudonne_10_5_4 d (fun _ ↦ 0) (fun _ ↦ 0) 1 W (fun _ ↦ 1) a b
      hab hZero hZero hW hOne
  exact ⟨hVc, hVa, hW_eq, S, hS, hderiv⟩

end RoundedClocks
