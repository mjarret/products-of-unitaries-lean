/-! # The full insertion series and its Jacobi telescope in Lemma A.3 -/
@[expose] public section
noncomputable section
open scoped Matrix.Norms.L2Operator Topology BigOperators
open Complex Real Set Filter MeasureTheory
open UnitaryProducts UnitaryProducts.Corrector UnitaryProducts.Paper.UnitStepsProse
namespace UnitaryProducts.PaperProof
attribute [local instance] matrixCStarAlgebra

/-- The noncommutative power derivative on an inner derivation telescopes.
Each summand is the difference of two adjacent terms. -/
theorem cubicPowDerivative_inner {A : Type*} [NormedRing A] (a b : A) (n : ℕ) :
    cubicPowDerivative a (a * b - b * a) n = a ^ n * b - b * a ^ n := by
  let f : ℕ → A := fun j ↦ a ^ (n - j) * b * a ^ j
  have hterm (j : ℕ) (hj : j ∈ Finset.range n) :
      a ^ (n - 1 - j) * (a * b - b * a) * a ^ j = f j - f (j + 1) := by
    have hjn := Finset.mem_range.mp hj
    have hleft : n - j = (n - 1 - j) + 1 := by omega
    have hright : n - (j + 1) = n - 1 - j := by omega
    dsimp only [f]
    rw [hleft, hright, pow_succ a (n - 1 - j), pow_succ' a j]
    noncomm_ring
  rw [cubicPowDerivative, Finset.sum_congr rfl hterm, Finset.sum_range_sub']
  simp [f]

variable {d : ℕ}
local notation "𝕄" => Matrix (Fin d) (Fin d) ℂ

/-- The finite insertion sum in the paper's order, with all `n` insertions. -/
theorem cubicPowDerivative_outer_sum (Ω A D : 𝕄) (n : ℕ) :
    cubicPowDerivative (adL Ω) (adL A) n D =
      ∑ k ∈ Finset.range n, (adL Ω ^ k) (adL A ((adL Ω ^ (n - 1 - k)) D)) := by
  simp only [cubicPowDerivative, ContinuousLinearMap.sum_apply,
    ContinuousLinearMap.mul_apply]
  rw [← Finset.sum_range_reflect
    (fun k ↦ (adL Ω ^ k) (adL A ((adL Ω ^ (n - 1 - k)) D))) n]
  apply Finset.sum_congr rfl
  intro k hk
  have hk' : k ≤ n - 1 := by have := Finset.mem_range.mp hk; omega
  simp only [Nat.sub_sub_self hk']

/-- Jacobi's identity identifies the insertion generated by `[Ω,B]` with
an operator commutator. -/
theorem adL_commutator (Ω B : 𝕄) :
    adL (adL Ω B) = adL Ω * adL B - adL B * adL Ω := by
  apply ContinuousLinearMap.ext
  intro D
  simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.mul_apply, adL_apply]
  noncomm_ring

/-- The two surviving terms in the finite Jacobi telescope in Lemma A.3. -/
theorem cubicPowDerivative_commutator_telescope (Ω B D : 𝕄) (n : ℕ) :
    cubicPowDerivative (adL Ω) (adL (adL Ω B)) n D =
      (adL Ω ^ n) (adL B D) - adL B ((adL Ω ^ n) D) := by
  rw [adL_commutator, cubicPowDerivative_inner]
  rfl

/-- Each individual insertion in the positive-coefficient series of Lemma A.3
has the displayed bound, before summing the `n` terms. -/
theorem norm_ad_insertion_le [NeZero d] {Ω : 𝕄}
    (hΩ : Ω.IsHermitian) {w : ℝ} (hw0 : 0 ≤ w)
    (hwidth : ∀ p q, |hΩ.eigenvalues p - hΩ.eigenvalues q| ≤ w)
    (A D : 𝕄) {n k : ℕ} (hk : k < n) {ν : ℝ} (hν : 0 ≤ ν) :
    ‖(ν : ℂ) • ((adL Ω ^ k) (adL A ((adL Ω ^ (n - 1 - k)) D)))‖ ≤
      2 * ν * w ^ (n - 1) * ‖A‖ * ‖D‖ := by
  have hp (m : ℕ) (X : 𝕄) : ‖(adL Ω ^ m) X‖ ≤ w ^ m * ‖X‖ :=
    (ContinuousLinearMap.le_opNorm _ _).trans
      (mul_le_mul_of_nonneg_right (ad_power_norm_le hΩ hwidth m) (norm_nonneg _))
  have ha : ‖adL A‖ ≤ 2 * ‖A‖ := by
    have h := norm_I_smul_adL_le A 0
    simpa only [norm_smul, Complex.norm_I, one_mul, zero_smul, sub_zero] using h
  have hmiddle (X : 𝕄) : ‖adL A X‖ ≤ 2 * ‖A‖ * ‖X‖ :=
    (ContinuousLinearMap.le_opNorm _ _).trans
      (mul_le_mul_of_nonneg_right ha (norm_nonneg _))
  rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hν]
  calc
    _ ≤ ν * (w ^ k * (2 * ‖A‖ * (w ^ (n - 1 - k) * ‖D‖))) := by
      gcongr
      exact (hp k _).trans (mul_le_mul_of_nonneg_left
        ((hmiddle _).trans (mul_le_mul_of_nonneg_left (hp (n - 1 - k) D)
          (by positivity))) (pow_nonneg hw0 _))
    _ = 2 * ν * (w ^ k * w ^ (n - 1 - k)) * ‖A‖ * ‖D‖ := by ring
    _ = _ := by rw [← pow_add, show k + (n - 1 - k) = n - 1 by omega]

/-- Each of the `n` insertions is bounded with the spectral midpoint shift estimate
on the outer and inner powers and the elementary commutator estimate. -/
theorem norm_cubicPowDerivative_ad_le [NeZero d] {Ω : 𝕄}
    (hΩ : Ω.IsHermitian) {w : ℝ} (hw0 : 0 ≤ w)
    (hwidth : ∀ p q, |hΩ.eigenvalues p - hΩ.eigenvalues q| ≤ w)
    (A D : 𝕄) (n : ℕ) :
    ‖cubicPowDerivative (adL Ω) (adL A) n D‖ ≤
      2 * n * w ^ (n - 1) * ‖A‖ * ‖D‖ := by
  rw [cubicPowDerivative_outer_sum]
  calc
    _ ≤ ∑ k ∈ Finset.range n,
        ‖(adL Ω ^ k) (adL A ((adL Ω ^ (n - 1 - k)) D))‖ := norm_sum_le _ _
    _ ≤ ∑ _k ∈ Finset.range n, 2 * w ^ (n - 1) * ‖A‖ * ‖D‖ := by
      apply Finset.sum_le_sum
      intro k hk
      simpa only [Complex.ofReal_one, one_smul, mul_one] using
        norm_ad_insertion_le hΩ hw0 hwidth A D (Finset.mem_range.mp hk) zero_le_one
    _ = _ := by simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]; ring

/-- The derivative majorant in the first paragraph of the proof of Lemma A.3.
The natural exponent makes the zero-degree term vanish before summation. -/
theorem norm_nested_commutator_derivative_le [NeZero d] {Ω : 𝕄}
    (hΩ : Ω.IsHermitian) {w : ℝ} (hw0 : 0 ≤ w)
    (hwidth : ∀ p q, |hΩ.eigenvalues p - hΩ.eigenvalues q| ≤ w)
    (D Dd : 𝕄) (n : ℕ) :
    ‖cubicPowDerivative (adL Ω) (adL D) n D + (adL Ω ^ n) Dd‖ ≤
      w ^ n * ‖Dd‖ + 2 * n * w ^ (n - 1) * ‖D‖ ^ 2 := by
  have hp : ‖(adL Ω ^ n) Dd‖ ≤ w ^ n * ‖Dd‖ :=
    (ContinuousLinearMap.le_opNorm _ _).trans
      (mul_le_mul_of_nonneg_right (ad_power_norm_le hΩ hwidth n) (norm_nonneg _))
  calc
    _ ≤ ‖cubicPowDerivative (adL Ω) (adL D) n D‖ + ‖(adL Ω ^ n) Dd‖ := norm_add_le _ _
    _ ≤ 2 * n * w ^ (n - 1) * ‖D‖ * ‖D‖ + w ^ n * ‖Dd‖ :=
      add_le_add (norm_cubicPowDerivative_ad_le hΩ hw0 hwidth D D n) hp
    _ = _ := by ring

/-- Absolute convergence of the full insertion series with positive coefficients. -/
theorem summable_frameError_positive [NeZero d] (Ω A D : 𝕄)
    (ha : ‖I • adL Ω‖ < 2 * π) :
    Summable (fun n : ℕ ↦
      ((|((bernoulli (n + 2) : ℚ) : ℝ)| / (Nat.factorial (n + 2) : ℝ) : ℝ) : ℂ) •
        cubicPowDerivative (adL Ω) (adL A) n D) := by
  have hs := (summable_norm_cubicFrameSeriesDerivative (b := I • adL A) ha).of_norm
  have he := ((ContinuousLinearMap.apply ℂ 𝕄 D).hasSum hs.hasSum).summable
  change Summable (fun n : ℕ ↦
    ((((bernoulli (n + 2) : ℚ) : ℂ) / (Nat.factorial (n + 2) : ℂ)) •
      cubicPowDerivative (I • adL Ω) (I • adL A) n) D) at he
  apply he.congr
  intro n
  rw [ContinuousLinearMap.smul_apply, cubicPowDerivative_smul_both,
    ContinuousLinearMap.smul_apply, smul_smul, UnitaryProducts.Prose.frame_coefficient_mul_I_pow]

/-- `F(A)` in the exact positive-degree indexing used in Lemma A.3. -/
theorem unifiedFrameError_full_series [NeZero d] (Ω A D : 𝕄)
    (ha : ‖I • adL Ω‖ < 2 * π) :
    unifiedFrameError Ω A D = ∑' n : ℕ,
      ((|((bernoulli (n + 3) : ℚ) : ℝ)| / (Nat.factorial (n + 3) : ℝ) : ℝ) : ℂ) •
        (∑ k ∈ Finset.range (n + 1),
          (adL Ω ^ k) (adL A ((adL Ω ^ (n - k)) D))) := by
  rw [unifiedFrameError_positive_series Ω A D ha,
    (summable_frameError_positive Ω A D ha).tsum_eq_zero_add]
  simp only [cubicPowDerivative, Finset.range_zero, Finset.sum_empty,
    ContinuousLinearMap.zero_apply, smul_zero, zero_add]
  apply tsum_congr
  intro n
  congr 1
  simpa only [Nat.add_sub_cancel] using cubicPowDerivative_outer_sum Ω A D (n + 1)

/-- The full insertion map is additive in its direction argument. -/
theorem unifiedFrameError_add_direction [NeZero d] (Ω A B D : 𝕄)
    (ha : ‖I • adL Ω‖ < 2 * π) :
    unifiedFrameError Ω (A + B) D = unifiedFrameError Ω A D + unifiedFrameError Ω B D := by
  have had : adL (A + B) = adL A + adL B := by
    apply ContinuousLinearMap.ext
    intro X
    simp only [ContinuousLinearMap.add_apply, adL_apply, add_mul, mul_add]
    abel
  have hpow (n : ℕ) : cubicPowDerivative (adL Ω) (adL (A + B)) n D =
      cubicPowDerivative (adL Ω) (adL A) n D +
        cubicPowDerivative (adL Ω) (adL B) n D := by
    simp only [cubicPowDerivative, had, mul_add, add_mul, Finset.sum_add_distrib,
      ContinuousLinearMap.add_apply]
  rw [unifiedFrameError_positive_series Ω (A + B) D ha,
    unifiedFrameError_positive_series Ω A D ha, unifiedFrameError_positive_series Ω B D ha]
  simp_rw [hpow, smul_add]
  exact (summable_frameError_positive Ω A D ha).tsum_add
    (summable_frameError_positive Ω B D ha)

/-- The estimate for `F(A)` in Lemma A.3 sums all `n` insertion bounds. -/
theorem norm_unifiedFrameError_le [NeZero d] {Ω : 𝕄}
    (hΩ : Ω.IsHermitian) {w : ℝ} (hw0 : 0 ≤ w) (hw : w < 2 * π)
    (hwidth : ∀ p q, |hΩ.eigenvalues p - hΩ.eigenvalues q| ≤ w) (A D : 𝕄) :
    ‖unifiedFrameError Ω A D‖ ≤ 2 * frameLip w * ‖A‖ * ‖D‖ := by
  have ha : ‖I • adL Ω‖ < 2 * π := by
    rw [norm_smul, Complex.norm_I, one_mul]
    exact (show ‖adL Ω‖ ≤ w by
      simpa only [pow_one] using ad_power_norm_le hΩ hwidth 1).trans_lt hw
  let c : ℕ → ℝ := fun n ↦ |((bernoulli (n + 2) : ℚ) : ℝ)| /
    (Nat.factorial (n + 2) : ℝ)
  let f : ℕ → 𝕄 := fun n ↦ (c n : ℂ) • cubicPowDerivative (adL Ω) (adL A) n D
  let g : ℕ → ℝ := fun n ↦
    (|((bernoulli (n + 2) : ℚ) : ℝ)| * n * w ^ (n - 1) /
      (Nat.factorial (n + 2) : ℝ)) * (2 * ‖A‖ * ‖D‖)
  have hg : Summable g := (summable_frameLip_majorant hw0 hw).mul_right _
  have hbound (n : ℕ) : ‖f n‖ ≤ g n := by
    dsimp only [f]
    rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by dsimp [c]; positivity)]
    calc
      _ ≤ c n * (2 * n * w ^ (n - 1) * ‖A‖ * ‖D‖) :=
        mul_le_mul_of_nonneg_left (norm_cubicPowDerivative_ad_le hΩ hw0 hwidth A D n)
          (by dsimp [c]; positivity)
      _ = g n := by dsimp [c, g]; ring
  have hfn : Summable (fun n ↦ ‖f n‖) :=
    Summable.of_nonneg_of_le (fun _ ↦ norm_nonneg _) hbound hg
  have he : unifiedFrameError Ω A D = ∑' n, f n := by
    rw [unifiedFrameError_full_series Ω A D ha]
    have hs : Summable f := summable_frameError_positive Ω A D ha
    rw [hs.tsum_eq_zero_add]
    have hz : f 0 = 0 := by simp [f, cubicPowDerivative]
    rw [hz, zero_add]
    apply tsum_congr
    intro n
    dsimp only [f, c]
    congr 1
    simpa only [Nat.add_sub_cancel] using
      (cubicPowDerivative_outer_sum Ω A D (n + 1)).symm
  rw [he]
  calc
    ‖∑' n, f n‖ ≤ ∑' n, ‖f n‖ := norm_tsum_le_tsum_norm hfn
    _ ≤ ∑' n, g n := hfn.tsum_le_tsum hbound hg
    _ = 2 * frameLip w * ‖A‖ * ‖D‖ := by
      rw [show (∑' n, g n) = frameLip w * (2 * ‖A‖ * ‖D‖) from tsum_mul_right]
      ring

/-- The literal infinite Jacobi telescope in Lemma A.3. -/
theorem unifiedFrameError_commutator_series [NeZero d] (Ω B D : 𝕄)
    (ha : ‖I • adL Ω‖ < 2 * π) :
    unifiedFrameError Ω (adL Ω B) D = ∑' n : ℕ,
      ((|((bernoulli (n + 3) : ℚ) : ℝ)| / (Nat.factorial (n + 3) : ℝ) : ℝ) : ℂ) •
        ((adL Ω ^ (n + 1)) (adL B D) - adL B ((adL Ω ^ (n + 1)) D)) := by
  rw [unifiedFrameError_positive_series Ω (adL Ω B) D ha,
    (summable_frameError_positive Ω (adL Ω B) D ha).tsum_eq_zero_add]
  have hz : cubicPowDerivative (adL Ω) (adL (adL Ω B)) 0 D = 0 := by
    simp [cubicPowDerivative]
  rw [hz, smul_zero, zero_add]
  apply tsum_congr
  intro n
  rw [cubicPowDerivative_commutator_telescope]

/-- The positive-degree scalar series is `N(w)-N(0)`. -/
theorem frameBound_positive_tail {w : ℝ} (hw0 : 0 ≤ w) (hw : w < 2 * π) :
    (∑' n : ℕ, |((bernoulli (n + 3) : ℚ) : ℝ)| * w ^ (n + 1) /
      (Nat.factorial (n + 3) : ℝ)) = frameBound w - frameBound 0 := by
  have hsplit := (summable_frameBound_majorant hw0 hw).tsum_eq_zero_add
  change frameBound w = _ at hsplit
  have hzero : |((bernoulli (0 + 2) : ℚ) : ℝ)| * w ^ 0 /
      (Nat.factorial (0 + 2) : ℝ) = frameBound 0 := by
    rw [frameBound_zero]
    norm_num [bernoulli_eq_bernoulli'_of_ne_one, bernoulli'_two, Nat.factorial]
  rw [hzero] at hsplit
  simp only [Nat.add_assoc] at hsplit
  linarith

/-- Absolute convergence of the positive series for `N(ad Ω)` applied to a matrix. -/
theorem summable_frameOp_positive [NeZero d] (Ω D : 𝕄)
    (ha : ‖I • adL Ω‖ < 2 * π) :
    Summable (fun n : ℕ ↦
      ((|((bernoulli (n + 2) : ℚ) : ℝ)| /
        (Nat.factorial (n + 2) : ℝ) : ℝ) : ℂ) • (adL Ω ^ n) D) := by
  have hs := (summable_norm_frameSeries_terms (I • adL Ω) ha).of_norm
  have hp : Summable (fun n : ℕ ↦
      ((|((bernoulli (n + 2) : ℚ) : ℝ)| /
        (Nat.factorial (n + 2) : ℝ) : ℝ) : ℂ) • adL Ω ^ n) :=
    hs.congr (UnitaryProducts.Prose.frame_term_I_smul (adL Ω))
  simpa only [ContinuousLinearMap.apply_apply, ContinuousLinearMap.smul_apply] using
    (ContinuousLinearMap.apply ℂ 𝕄 D).summable hp

/-- Removing the constant coefficient gives the series for `N(ad Ω)-N(0)`. -/
theorem frameOp_sub_zero_series [NeZero d] (Ω D : 𝕄)
    (ha : ‖I • adL Ω‖ < 2 * π) :
    frameOp Ω D - (frameBound 0 : ℂ) • D = ∑' n : ℕ,
      ((|((bernoulli (n + 3) : ℚ) : ℝ)| /
        (Nat.factorial (n + 3) : ℝ) : ℝ) : ℂ) • (adL Ω ^ (n + 1)) D := by
  rw [UnitaryProducts.Prose.frameOp_eq_positive_series Ω D ha,
    (summable_frameOp_positive Ω D ha).tsum_eq_zero_add]
  have hzero : ((|((bernoulli (0 + 2) : ℚ) : ℝ)| /
      (Nat.factorial (0 + 2) : ℝ) : ℝ) : ℂ) • (adL Ω ^ 0) D =
      (frameBound 0 : ℂ) • D := by
    rw [frameBound_zero]
    norm_num [bernoulli_eq_bernoulli'_of_ne_one, bernoulli'_two, Nat.factorial]
  rw [hzero, add_sub_cancel_left]

/-- Lemma A.3's guessed closed form of `F([Ω,Λ])`. The Jacobi identity
turns the finite derivative sum into a telescope; summing its boundary terms
verifies the guess before applying the norm bound in (F-split). -/
theorem unifiedFrameError_commutator_closed [NeZero d] (Ω B D : 𝕄)
    (ha : ‖I • adL Ω‖ < 2 * π) :
    unifiedFrameError Ω (adL Ω B) D =
      (frameOp Ω (adL B D) - (frameBound 0 : ℂ) • adL B D) -
        adL B (frameOp Ω D - (frameBound 0 : ℂ) • D) := by
  have hs (E : 𝕄) : Summable (fun n : ℕ ↦
      ((|((bernoulli (n + 3) : ℚ) : ℝ)| /
        (Nat.factorial (n + 3) : ℝ) : ℝ) : ℂ) • (adL Ω ^ (n + 1)) E) := by
    simpa only [Nat.add_assoc] using
      (summable_nat_add_iff 1).mpr (summable_frameOp_positive Ω E ha)
  rw [unifiedFrameError_commutator_series Ω B D ha,
    frameOp_sub_zero_series Ω (adL B D) ha, frameOp_sub_zero_series Ω D ha,
    (adL B).map_tsum (hs D), ← (hs (adL B D)).tsum_sub ((adL B).summable (hs D))]
  apply tsum_congr
  intro n
  simp only [smul_sub, map_smul]

/-- The positive series bounds `N(ad Ω)-N(0)` by `N(w)-N(0)`. -/
theorem norm_frameOp_sub_zero_le [NeZero d] {Ω : 𝕄}
    (hΩ : Ω.IsHermitian) {w : ℝ} (hw0 : 0 ≤ w) (hw : w < 2 * π)
    (hwidth : ∀ p q, |hΩ.eigenvalues p - hΩ.eigenvalues q| ≤ w) (D : 𝕄) :
    ‖frameOp Ω D - (frameBound 0 : ℂ) • D‖ ≤
      (frameBound w - frameBound 0) * ‖D‖ := by
  have ha : ‖I • adL Ω‖ < 2 * π := by
    rw [norm_smul, Complex.norm_I, one_mul]
    exact (show ‖adL Ω‖ ≤ w by
      simpa only [pow_one] using ad_power_norm_le hΩ hwidth 1).trans_lt hw
  let c : ℕ → ℝ := fun n ↦ |((bernoulli (n + 3) : ℚ) : ℝ)| /
    (Nat.factorial (n + 3) : ℝ)
  let f : ℕ → 𝕄 := fun n ↦ (c n : ℂ) • (adL Ω ^ (n + 1)) D
  let g : ℕ → ℝ := fun n ↦
    (|((bernoulli (n + 3) : ℚ) : ℝ)| * w ^ (n + 1) /
      (Nat.factorial (n + 3) : ℝ)) * ‖D‖
  have hg : Summable g := by
    simpa only [Nat.add_assoc] using
      ((summable_nat_add_iff 1).mpr (summable_frameBound_majorant hw0 hw)).mul_right ‖D‖
  have hbound (n : ℕ) : ‖f n‖ ≤ g n := by
    dsimp only [f]
    rw [norm_smul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (by dsimp [c]; positivity)]
    have hp : ‖(adL Ω ^ (n + 1)) D‖ ≤ w ^ (n + 1) * ‖D‖ :=
      (ContinuousLinearMap.le_opNorm _ _).trans
        (mul_le_mul_of_nonneg_right (ad_power_norm_le hΩ hwidth (n + 1)) (norm_nonneg _))
    calc
      _ ≤ c n * (w ^ (n + 1) * ‖D‖) :=
        mul_le_mul_of_nonneg_left hp (by dsimp [c]; positivity)
      _ = g n := by dsimp [c, g]; ring
  have hfn : Summable (fun n ↦ ‖f n‖) :=
    Summable.of_nonneg_of_le (fun _ ↦ norm_nonneg _) hbound hg
  rw [frameOp_sub_zero_series Ω D ha]
  change ‖∑' n, f n‖ ≤ _
  calc
    _ ≤ ∑' n, ‖f n‖ := norm_tsum_le_tsum_norm hfn
    _ ≤ ∑' n, g n := hfn.tsum_le_tsum hbound hg
    _ = (frameBound w - frameBound 0) * ‖D‖ := by
      dsimp only [g]
      rw [tsum_mul_right, frameBound_positive_tail hw0 hw]

/-- The closed Jacobi expression is bounded by the positive-series estimate
for `N-N(0)` and the elementary commutator bound. -/
theorem norm_unifiedFrameError_commutator_le [NeZero d] {Ω : 𝕄}
    (hΩ : Ω.IsHermitian) {w : ℝ} (hw0 : 0 ≤ w) (hw : w < 2 * π)
    (hwidth : ∀ p q, |hΩ.eigenvalues p - hΩ.eigenvalues q| ≤ w) (B D : 𝕄) :
    ‖unifiedFrameError Ω (adL Ω B) D‖ ≤
      4 * (frameBound w - frameBound 0) * ‖B‖ * ‖D‖ := by
  have ha : ‖I • adL Ω‖ < 2 * π := by
    rw [norm_smul, Complex.norm_I, one_mul]
    exact (show ‖adL Ω‖ ≤ w by
      simpa only [pow_one] using ad_power_norm_le hΩ hwidth 1).trans_lt hw
  have htail : 0 ≤ frameBound w - frameBound 0 := by
    rw [← frameBound_positive_tail hw0 hw]
    exact tsum_nonneg (fun _ ↦ by positivity)
  have hc (E : 𝕄) : ‖adL B E‖ ≤ 2 * ‖B‖ * ‖E‖ := by
    simpa only [zero_smul, sub_zero] using norm_adL_apply_le B E 0
  rw [unifiedFrameError_commutator_closed Ω B D ha]
  calc
    _ ≤ ‖frameOp Ω (adL B D) - (frameBound 0 : ℂ) • adL B D‖ +
        ‖adL B (frameOp Ω D - (frameBound 0 : ℂ) • D)‖ := norm_sub_le _ _
    _ ≤ (frameBound w - frameBound 0) * ‖adL B D‖ +
        2 * ‖B‖ * ‖frameOp Ω D - (frameBound 0 : ℂ) • D‖ :=
      add_le_add (norm_frameOp_sub_zero_le hΩ hw0 hw hwidth _) (hc _)
    _ ≤ (frameBound w - frameBound 0) * (2 * ‖B‖ * ‖D‖) +
        2 * ‖B‖ * ((frameBound w - frameBound 0) * ‖D‖) := by
      exact add_le_add (mul_le_mul_of_nonneg_left (hc D) htail)
        (mul_le_mul_of_nonneg_left (norm_frameOp_sub_zero_le hΩ hw0 hw hwidth D)
          (by positivity))
    _ = _ := by ring

/-- The positive-degree coefficients make `N(w)-N(0)` nonnegative. -/
theorem frameBound_sub_zero_nonneg {w : ℝ} (hw0 : 0 ≤ w) (hw : w < 2 * π) :
    0 ≤ frameBound w - frameBound 0 := by
  rw [← frameBound_positive_tail hw0 hw]
  exact tsum_nonneg (fun _ ↦ by positivity)

/-- The arbitrary split (F-split): linearity, the insertion estimate, and the
closed Jacobi expression apply to every decomposition `D = X + [Ω,B]`. -/
theorem norm_unifiedFrameError_split_le [NeZero d] {Ω : 𝕄}
    (hΩ : Ω.IsHermitian) {w : ℝ} (hw0 : 0 ≤ w) (hw : w < 2 * π)
    (hwidth : ∀ p q, |hΩ.eigenvalues p - hΩ.eigenvalues q| ≤ w)
    (D X B : 𝕄) (hdecomp : D = X + adL Ω B) :
    ‖unifiedFrameError Ω D D‖ ≤ 2 * frameLip w * ‖X‖ * ‖D‖ +
      4 * (frameBound w - frameBound 0) * ‖B‖ * ‖D‖ := by
  have ha : ‖I • adL Ω‖ < 2 * π := by
    rw [norm_smul, Complex.norm_I, one_mul]
    exact (show ‖adL Ω‖ ≤ w by
      simpa only [pow_one] using ad_power_norm_le hΩ hwidth 1).trans_lt hw
  have he : unifiedFrameError Ω D D =
      unifiedFrameError Ω X D + unifiedFrameError Ω (adL Ω B) D := by
    conv_lhs => arg 2; rw [hdecomp]
    exact unifiedFrameError_add_direction Ω X (adL Ω B) D ha
  rw [he]
  exact (norm_add_le _ _).trans
    (add_le_add (norm_unifiedFrameError_le hΩ hw0 hw hwidth X D)
      (norm_unifiedFrameError_commutator_le hΩ hw0 hw hwidth B D))

end UnitaryProducts.PaperProof
