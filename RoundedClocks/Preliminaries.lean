/-!
# Section 2: Preliminaries

In the paper's order:

* the evolution of a regulated Hermitian family exists and is unique (the paragraph after
  equation (2.1)): `generates_exists`, `generates_evolutionOf`, `generates_unique`;
* Section 2.1, Comparing two evolutions:
  * Theorem 2.2, the comparison of evolutions: `comparison`;
  * equation (2.3), Duhamel's bound: `duhamel`;
  * equation (2.4), the evolution of a piecewise-constant family ends at a product:
    `piecewise_product`;
  * equation (2.5), the rounded-clock identity: `roundedEvolution_end`;
  * Proposition 2.4, the transfer of leakage bounds: `transfer`.

Definitions 2.1 and 2.3, equation (2.1), and Definition 2.5 of Section 2.2, Bands, are in
`Definitions.lean`.

The supporting lemmas are in `Preliminaries/`:

* `Basic`: the parts of "`G` generates `V`" and of checkpoints, by name;
* `Regulated`: sums, products, adjoints, and restrictions of regulated functions are regulated;
* `RegulatedApproximation`, `RegulatedIntegrability`: a regulated function is bounded, continuous
  outside a countable set, and integrable (the sentence after Definition 2.1);
* `EvolutionUnitarity`: "the solution `V` is unitary as `G` is Hermitian";
* `Reparameterization`: "with `s = t/T`, `U(Ts)` for `s ∈ [0,1]` is generated by `T H(s)`";
* `EvolutionComparisonCalculus`: the derivatives in (2.2), integrated over one piece
  `[pⱼ, pⱼ₊₁]`;
* `ComparisonIdentity`: the last line of (2.2) and the finite sums in the display of the proof of
  Theorem 2.2;
* `PiecewiseEvolution`: the recursion before (2.4), and the intervals of the rounded clock for
  (2.5).
-/

@[expose] public section

open scoped Matrix.Norms.L2Operator Topology Real Asymptotics
open Set Filter MeasureTheory
open Complex (I)
open NormedSpace (exp)

noncomputable section

namespace RoundedClocks

variable {d : ℕ}

local notation "𝕄" => Matrix (Fin d) (Fin d) ℂ

/-! ## Evolutions (the paragraph after equation (2.1)) -/

/-- Section 2 (existence of evolutions). Assuming Dieudonné (10.5.4) and (10.6.3) with the remark
(10.4.6), a regulated Hermitian family `G(t)` with `t ∈ [a,b]` generates an evolution. -/
theorem generates_exists (dieudonne_10_5_4 : Dieudonne_10_5_4)
    (dieudonne_10_6_3 : Dieudonne_10_6_3)
    {G : ℝ → 𝕄} {a b : ℝ} (hab : a ≤ b) (hreg : IsRegulated G a b)
    (hG : IsHermitianFamily G a b) : ∃ V, Generates G V a b := by
  rcases eq_or_lt_of_le hab with hzero | hpos
  · -- On the one-point interval `a = b`, the evolution is `V = 1`.
    subst b
    refine ⟨fun _ ↦ 1, continuousOn_const, rfl, ?_, {a}, countable_singleton a, ?_⟩
    · intro t ht
      simp [IsUnitary]
    · intro t ht hn
      exact (hn (le_antisymm ht.2 ht.1)).elim
  · -- The maps `X ↦ -iG(t)X` are regulated in `t`, so by Dieudonné (10.6.3) there is a continuous
    -- `V` with `V(a) = 1` and `V' = -iGV` for all but countably many `t`.
    obtain ⟨V, hV, -⟩ :=
      dieudonne_10_6_3 d (fun t ↦ -I • G t) (fun _ ↦ 0) 1 a b a hpos ⟨le_rfl, hab⟩
        (hreg.const_smul (-I)) (isRegulated_const 0 a b)
    -- The solution `V` is unitary as `G` is Hermitian.
    exact ⟨V, generates_of_hermitian_solution dieudonne_10_5_4 hab hG hV⟩

/-- Section 2 (existence of evolutions). Assuming Dieudonné (10.5.4) and (10.6.3) with the remark
(10.4.6), a regulated Hermitian family `G(t)` with `t ∈ [0,T]` generates `evolutionOf G T`. -/
theorem generates_evolutionOf (dieudonne_10_5_4 : Dieudonne_10_5_4)
    (dieudonne_10_6_3 : Dieudonne_10_6_3)
    {G : ℝ → 𝕄} {T : ℝ} (hT : 0 ≤ T) (hreg : IsRegulated G 0 T)
    (hG : IsHermitianFamily G 0 T) : Generates G (evolutionOf G T) 0 T := by
  exact generates_evolutionOf_of_exists
    (generates_exists dieudonne_10_5_4 dieudonne_10_6_3 hT hreg hG)

/-- Section 2 (uniqueness of evolutions). Assuming Dieudonné (10.5.4), a regulated family `G(t)`
with `t ∈ [a,b]` generates at most one evolution. -/
theorem generates_unique (dieudonne_10_5_4 : Dieudonne_10_5_4) {G V V' : ℝ → 𝕄}
    {a b : ℝ} (hreg : IsRegulated G a b) (hV : Generates G V a b)
    (hV' : Generates G V' a b) : EqOn V V' (Icc a b) := by
  by_cases hab : a ≤ b
  · -- Each evolution that `G` generates solves `X' = -iGX` with `X(a) = 1`.
    have hsolve : ∀ W : ℝ → 𝕄, Generates G W a b →
        SolvesLinearMatrixODE (fun t ↦ -I • G t) (fun _ ↦ 0) 1 W a a b := by
      intro W hW
      obtain ⟨S, hS, hd⟩ := hW.deriv
      refine ⟨hW.continuousOn, hW.init, S, hS, ?_⟩
      intro t ht hn
      simpa only [add_zero, Matrix.smul_mul] using hd t ht hn
    -- The maps `X ↦ -iG(t)X` are regulated in `t`, so Dieudonné (10.5.4) gives uniqueness.
    exact dieudonne_10_5_4 d (fun t ↦ -I • G t) (fun _ ↦ 0) 1 V V' a b hab
      (hreg.const_smul (-I)) (isRegulated_const 0 a b) (hsolve V hV) (hsolve V' hV')
  · -- The interval is empty when `b < a`.
    intro t ht
    exact (hab (ht.1.trans ht.2)).elim

/-! ## Section 2.1: Comparing two evolutions -/

/-- **Theorem 2.2.** Assuming Dieudonné (7.6.1), let regulated families
`K(t)` and `G(t)` with `t ∈ [a,b]` generate `U` and `V`, respectively, with `K(t)` Hermitian.
Let `m ≥ 0` be an integer,
and let `a = p₀ ≤ p₁ ≤ ⋯ ≤ pₘ₊₁ = b`. For `0 ≤ j ≤ m`, let the pieces `Yⱼ(t)` for
`t ∈ [pⱼ,pⱼ₊₁]` be continuous and matrix-valued, with a derivative that, for all but countably many
`t`, exists and agrees with a regulated function. Let `R(t)` be the residual
`R = K - G - Yⱼ' - i(K Yⱼ - Yⱼ G)` wherever `pⱼ < t < pⱼ₊₁` and `Yⱼ'(t)` exists, with arbitrary
values at the remaining countably many `t`. Let `Δⱼ = Yⱼ(pⱼ) - Yⱼ₋₁(pⱼ)` for `1 ≤ j ≤ m`. Then
`U(b)† V(b) - 1 = ∫_a^b i U† R V dt + i U(b)† Yₘ(b) V(b) - i Y₀(a) - i Σ_{j=1}^m U(pⱼ)† Δⱼ V(pⱼ)`.

Below, `Y' j` is the regulated function with which the derivative of `Y j` agrees outside the
countable set `S j`. The statement holds without the paper's assumption that `G` is Hermitian. -/
theorem comparison (dieudonne_7_6_1 : Dieudonne_7_6_1) {a b : ℝ}
    [NeZero d] (K G U V : ℝ → 𝕄) (hK : IsRegulated K a b)
    (hKh : IsHermitianFamily K a b)
    (hG : IsRegulated G a b) (hU : Generates K U a b)
    (hV : Generates G V a b) (m : ℕ) (p : ℕ → ℝ)
    (hp : ∀ j ≤ m, p j ≤ p (j + 1)) (ha : p 0 = a) (hb : p (m + 1) = b)
    (Y : ℕ → ℝ → 𝕄) (S : ℕ → Set ℝ) (hS : ∀ j ≤ m, (S j).Countable)
    (hYc : ∀ j ≤ m, ContinuousOn (Y j) (Icc (p j) (p (j + 1))))
    (Y' : ℕ → ℝ → 𝕄) (hY' : ∀ j ≤ m, IsRegulated (Y' j) (p j) (p (j + 1)))
    (hYd : ∀ j ≤ m, ∀ t ∈ Ioo (p j) (p (j + 1)), t ∉ S j →
      HasDerivAt (Y j) (Y' j t) t)
    (R : ℝ → 𝕄)
    (hR : ∀ j ≤ m, ∀ t ∈ Ioo (p j) (p (j + 1)), t ∉ S j →
      R t = K t - G t - Y' j t - I • (K t * Y j t - Y j t * G t)) :
    (U b)† * V b - 1 = (∫ t in a..b, I • ((U t)† * R t * V t)) +
      I • ((U b)† * Y m b * V b) - I • Y 0 a -
      I • ∑ j ∈ Finset.Icc 1 m, (U (p j))† * (Y j (p j) - Y (j - 1) (p j)) * V (p j) := by
  classical
  -- The functions in the display of the paper's proof, `UV = U†V` and `UYV j = U†YⱼV`, and the
  -- three integrands of (2.2): `dUV = (U†V)' = iU†(K - G)V`,
  -- `dUYV j = (U†YⱼV)' = U†(Yⱼ' + i(KYⱼ - YⱼG))V`, and `iURV = iU†RV`.
  let UV := fun t ↦ (U t)† * V t
  let UYV := fun j t ↦ (U t)† * Y j t * V t
  let dUV := fun t ↦ I • ((U t)† * (K t - G t) * V t)
  let dUYV := fun j t ↦ (U t)† *
    (Y' j t + I • (K t * Y j t - Y j t * G t)) * V t
  let iURV := fun t ↦ I • ((U t)† * R t * V t)
  -- Each piece `[pⱼ, pⱼ₊₁]` lies in `[a,b]`.
  have hp' : ∀ j < m + 1, p j ≤ p (j + 1) := fun j hj ↦ hp j (Nat.lt_succ_iff.mp hj)
  have hleft (j : ℕ) (hj : j ≤ m) : a ≤ p j :=
    ha ▸ partition_mono hp' (Nat.zero_le j) (by omega)
  have hright (j : ℕ) (hj : j ≤ m) : p (j + 1) ≤ b :=
    hb ▸ partition_mono hp' (Nat.add_le_add_right hj 1) le_rfl
  have hpiece (j : ℕ) (hj : j ≤ m) : Icc (p j) (p (j + 1)) ⊆ Icc a b :=
    Icc_subset_Icc (hleft j hj) (hright j hj)
  -- On each piece, the continuous functions `U†V` and `U†YⱼV` are the integrals of their
  -- derivatives, which are regulated (the first and third lines of (2.2)).
  have hprim (j : ℕ) (hj : j ≤ m) :
      IsRegulated dUV (p j) (p (j + 1)) ∧ IsRegulated (dUYV j) (p j) (p (j + 1)) ∧
      (UV (p (j + 1)) - UV (p j) = ∫ t in p j..p (j + 1), dUV t) ∧
      (UYV j (p (j + 1)) - UYV j (p j) = ∫ t in p j..p (j + 1), dUYV j t) := by
    exact comparison_piece_primitives dieudonne_7_6_1 K G U V (Y j) (Y' j)
      (p j) (p (j + 1)) (hp j hj)
      (hK.mono (hleft j hj) (hright j hj))
      (hG.mono (hleft j hj) (hright j hj)) (hY' j hj)
      (fun t ht ↦ hKh (hpiece j hj ht)) (hU.continuousOn.mono (hpiece j hj))
      (hV.continuousOn.mono (hpiece j hj)) (hYc j hj)
      (hU.deriv.mono (hpiece j hj))
      (hV.deriv.mono (hpiece j hj))
      (DerivativeOffCountable.of_Ioo (hS j hj) (hYd j hj))
  have hUV (j : ℕ) (hj : j ≤ m) :
      UV (p (j + 1)) - UV (p j) = ∫ t in p j..p (j + 1), dUV t := (hprim j hj).2.2.1
  have hUYV (j : ℕ) (hj : j ≤ m) :
      UYV j (p (j + 1)) - UYV j (p j) = ∫ t in p j..p (j + 1), dUYV j t := (hprim j hj).2.2.2
  -- The last line of (2.2) holds for almost every `t` in a piece. So `iU†RV` is integrable there,
  -- whatever the values of `R` at the remaining `t`, and
  -- `∫ (U†V)' = ∫ iU†RV + i ∫ (U†YⱼV)'`, also when `pⱼ = pⱼ₊₁`.
  have hres (j : ℕ) (hj : j ≤ m) :
      IntervalIntegrable iURV MeasureTheory.volume (p j) (p (j + 1)) ∧
      (∫ t in p j..p (j + 1), dUV t) =
        (∫ t in p j..p (j + 1), iURV t) + I • (∫ t in p j..p (j + 1), dUYV j t) :=
    comparison_integral_residual dieudonne_7_6_1
      (hp j hj) (hprim j hj).1 (hprim j hj).2.1
      (comparison_residual_ae K G U V (Y j) (Y' j) R (hp j hj) (hS j hj) (hR j hj))
  -- The integrals of `iU†RV` over the pieces add up to its integral over `[a,b]`.
  have hsum : (∑ j ∈ Finset.range (m + 1), ∫ t in p j..p (j + 1), iURV t) =
      ∫ t in a..b, iURV t := by
    simpa only [ha, hb] using intervalIntegral.sum_integral_adjacent_intervals (n := m + 1)
      (fun j hj ↦ (hres j (by omega)).1)
  -- Neighboring pieces disagree at `p₁, …, pₘ` by the jumps `U(pⱼ)†ΔⱼV(pⱼ)`, where
  -- `Δⱼ = Yⱼ(pⱼ) - Yⱼ₋₁(pⱼ)`.
  have hjump : (∑ j ∈ Finset.range m,
      (UYV (j + 1) (p (j + 1)) - UYV j (p (j + 1)))) =
      ∑ j ∈ Finset.Icc 1 m, (U (p j))† *
        (Y j (p j) - Y (j - 1) (p j)) * V (p j) := by
    rw [← Finset.Ico_add_one_right_eq_Icc, Finset.sum_Ico_eq_sum_range,
      Nat.add_sub_cancel]
    simp only [Nat.one_add, Nat.succ_sub_one]
    apply Finset.sum_congr rfl
    intro j hj
    simp only [UYV, mul_sub, sub_mul]
  -- The display of the paper's proof.
  calc
    (U b)† * V b - 1 = ∑ j ∈ Finset.range (m + 1),
        ∫ t in p j..p (j + 1), dUV t := by
      -- First equality: `U(a) = V(a) = 1`.
      have ht := comparison_telescope UV p m
      have he : (∑ j ∈ Finset.range (m + 1),
          (UV (p (j + 1)) - UV (p j))) =
          ∑ j ∈ Finset.range (m + 1), ∫ t in p j..p (j + 1), dUV t :=
        Finset.sum_congr rfl fun j hj ↦ hUV j (by
          have := Finset.mem_range.mp hj; omega)
      rw [ht] at he
      simpa only [UV, ha, hb, hU.init, hV.init, star_one, one_mul] using he
    _ = ∑ j ∈ Finset.range (m + 1),
        ((∫ t in p j..p (j + 1), iURV t) +
          I • (∫ t in p j..p (j + 1), dUYV j t)) := by
      -- Second equality: (2.2).
      exact Finset.sum_congr rfl fun j hj ↦ (hres j (by
        have := Finset.mem_range.mp hj; omega)).2
    _ = (∫ t in a..b, iURV t) + I • ∑ j ∈ Finset.range (m + 1),
        (UYV j (p (j + 1)) - UYV j (p j)) := by
      -- Third equality: integrate the derivatives of `U†YⱼV`.
      rw [Finset.sum_add_distrib, ← Finset.smul_sum, hsum]
      congr 1
      congr 1
      exact Finset.sum_congr rfl fun j hj ↦ (hUYV j (by
        have := Finset.mem_range.mp hj; omega)).symm
    _ = _ := by
      -- Last equality: regroup the sum at each `pⱼ`, again using `U(a) = V(a) = 1`.
      rw [comparison_boundaries UYV p m, hjump]
      simp only [UYV, iURV, ha, hb, hU.init, hV.init, star_one, one_mul, mul_one,
        smul_sub]
      abel

/-- **Equation (2.3)** (Duhamel's bound). Assuming Dieudonné (7.6.1), if regulated
families `K(t)` and `G(t)` with `t ∈ [a,b]` generate `U` and `V`, and `K(t)` is Hermitian, then
`‖V(b) - U(b)‖ ≤ ∫_a^b ‖K - G‖ dt`. -/
theorem duhamel (dieudonne_7_6_1 : Dieudonne_7_6_1) {K G U V : ℝ → 𝕄}
    {a b : ℝ} (hab : a ≤ b) (hK : IsRegulated K a b) (hKh : IsHermitianFamily K a b)
    (hG : IsRegulated G a b) (hU : Generates K U a b)
    (hV : Generates G V a b) :
    ‖V b - U b‖ ≤ ∫ t in a..b, ‖K t - G t‖ := by
  classical
  by_cases hd : d = 0
  · subst d
    -- In dimension `0` every matrix is zero, so both sides vanish.
    have hzero (A : Matrix (Fin 0) (Fin 0) ℂ) : A = 0 := Subsingleton.elim _ _
    simp only [hzero (V b - U b), hzero (K _ - G _), norm_zero,
      intervalIntegral.integral_zero, le_refl]
  letI : NeZero d := ⟨hd⟩
  -- No correction: `m = 0` with `p₀ = a`, `p₁ = b`, and `Y₀ = 0`.
  let p : ℕ → ℝ := fun j ↦ if j = 0 then a else b
  have hp : ∀ j ≤ 0, p j ≤ p (j + 1) := by
    intro j hj
    have : j = 0 := by omega
    subst j
    simpa [p] using hab
  -- The residual is then `R = K - G`, and Theorem 2.2 gives `U(b)†V(b) - 1 = ∫ iU†(K - G)V`.
  have hidentity :
      (U b)† * V b - 1 = ∫ t in a..b, I • ((U t)† * (K t - G t) * V t) := by
    have h := RoundedClocks.comparison dieudonne_7_6_1 K G U V
      hK hKh hG hU hV 0 p hp
      (by simp [p]) (by simp [p]) (fun _ _ ↦ 0) (fun _ ↦ ∅)
      (fun _ _ ↦ countable_empty)
      (fun _ _ ↦ continuousOn_const) (fun _ _ ↦ 0)
      (fun _ _ ↦ isRegulated_const 0 _ _)
      (fun _ _ t _ _ ↦ hasDerivAt_const t 0) (fun t ↦ K t - G t)
      (fun _ _ _ _ _ ↦ by simp)
    simpa only [smul_zero, mul_zero, zero_mul, add_zero, sub_zero,
      Finset.sum_const_zero] using h
  -- The display (2.3): `U` and `V` are unitary, so they do not change the norm.
  calc
    ‖V b - U b‖ = ‖(U b)† * V b - 1‖ :=
      norm_sub_eq_norm_star_mul_sub_one (hU.isUnitary b ⟨hab, le_rfl⟩) (V b)
    _ = ‖∫ t in a..b, I • ((U t)† * (K t - G t) * V t)‖ :=
      congrArg norm hidentity
    _ ≤ ∫ t in a..b, ‖I • ((U t)† * (K t - G t) * V t)‖ :=
      intervalIntegral.norm_integral_le_integral_norm hab
    _ = ∫ t in a..b, ‖K t - G t‖ := by
      apply intervalIntegral.integral_congr
      intro t ht
      rw [uIcc_of_le hab] at ht
      change ‖I • ((U t)† * (K t - G t) * V t)‖ = ‖K t - G t‖
      rw [norm_smul, Complex.norm_I, one_mul,
        CStarRing.norm_mul_mem_unitary _ (hV.isUnitary t ht),
        CStarRing.norm_mem_unitary_mul _
          (Unitary.star_mem (hU.isUnitary t ht))]

/-- **Equation (2.4)** (the evolution of a piecewise-constant family). Let
`t_0 ≤ t_1 ≤ ⋯ ≤ t_n`, and let `G(t) = A_j` for `t_j < t < t_{j+1}` with Hermitian `A_j`, the
paper's `G_j`. Then `G` generates an evolution `V` with
`V(t_n) = e^{-i(t_n - t_{n-1})A_{n-1}} ⋯ e^{-i(t_1 - t_0)A_0}`. -/
theorem piecewise_product {n : ℕ} {t : ℕ → ℝ} (ht : ∀ j < n, t j ≤ t (j + 1)) {G : ℝ → 𝕄}
    {A : ℕ → 𝕄} (hA : ∀ j < n, IsHermitian (A j))
    (hG : ∀ j < n, ∀ x ∈ Ioo (t j) (t (j + 1)), G x = A j) :
    ∃ V, Generates G V (t 0) (t n) ∧
      V (t n) = orderedProduct n fun j ↦ exp ((-I * (t (j + 1) - t j : ℝ)) • A j) := by
  -- The recursion `V(t₀) = 1`, `V(x) = e^{-i(x - tⱼ)Gⱼ} V(tⱼ)` for `x ∈ [tⱼ, tⱼ₊₁]` defines the
  -- evolution that `G` generates.
  obtain ⟨V, hV, hend⟩ := exists_piecewise_evolution ht hA hG
  -- Its value at `tₙ` is the displayed product.
  exact ⟨V, hV, hend.trans (recursiveProduct_eq_list t A n)⟩

/-- **Equation (2.5)** (the rounded-clock identity). Assuming Dieudonné (10.5.4), for a
time-dependent Hamiltonian `H` and an integer `T ≥ 1`, the evolution `V` of `H(⌊t+1/2⌋/T)`
satisfies `V(T) = e^{-iH(1)/2} W_T e^{iH(0)/2}`, where `W_T` is the `T`-step product of `H`. -/
theorem roundedEvolution_end (dieudonne_10_5_4 : Dieudonne_10_5_4) {H : ℝ → 𝕄}
    (hH : IsTimeDepHamiltonian H) {T : ℕ} (hT : 1 ≤ T) :
    roundedEvolution H T T = exp (-(I / 2) • H 1) * stepProduct H T * exp ((I / 2) • H 0) := by
  -- The piecewise-constant family `H(⌊t+1/2⌋/T)`, the samples `H(j/T)`, and the lengths and end
  -- times of the intervals on which `⌊t+1/2⌋ = j`.
  let G : ℝ → 𝕄 := fun t ↦ H ((⌊t + 1 / 2⌋ : ℝ) / T)
  let A : ℕ → 𝕄 := fun j ↦ H (j / T)
  let len := roundedClockDuration T
  let t := switchTime len
  -- `H(⌊t+1/2⌋/T)` equals `H(j/T)` for `t` in an interval of length `1` when `0 < j < T` and of
  -- length `1/2` when `j ∈ {0, T}`, and these `T + 1` intervals fill `[0,T]`.
  obtain ⟨htT, hpiece⟩ := rounded_clock_partition H T hT
  have hlen : ∀ j, 0 ≤ len j := by
    intro j
    simp only [len, roundedClockDuration]
    split_ifs <;> norm_num
  have ht : ∀ j < T + 1, t j ≤ t (j + 1) := by
    intro j _
    change switchTime len j ≤ switchTime len j + len j
    exact le_add_of_nonneg_right (hlen j)
  have hA : ∀ j < T + 1, IsHermitian (A j) := by
    intro j hj
    apply hH
    exact unitInterval.div_mem (Nat.cast_nonneg j) (Nat.cast_nonneg T)
      (by exact_mod_cast (show j ≤ T by omega))
  have hG : ∀ j < T + 1, ∀ x ∈ Ioo (t j) (t (j + 1)), G x = A j := by
    simpa only [G, A, t, len] using hpiece
  -- By (2.4), this family generates an evolution `V` that ends at the product over the intervals.
  obtain ⟨V, hV, hVT⟩ := piecewise_product ht hA hG
  have ht0 : t 0 = 0 := by simp [t, switchTime]
  have htend : t (T + 1) = T := by simpa only [t, len] using htT
  have hV' : Generates G V 0 T := by simpa only [ht0, htend] using hV
  have hproduct : V T = durationProduct len A (T + 1) := by
    calc
      V T = orderedProduct (T + 1) (fun j ↦
          exp ((-I * (t (j + 1) - t j : ℝ)) • A j)) := by
        simpa only [htend] using hVT
      _ = orderedProduct (T + 1) (fun j ↦ exp ((-I * (len j : ℝ)) • A j)) := by
        simp only [orderedProduct]
        congr 1
        apply List.map_congr_left
        intro j _
        rw [show t = switchTime len from rfl, switchTime]
        congr 2
        ring
      _ = durationProduct len A (T + 1) := (durationProduct_eq_list len A (T + 1)).symm
  -- A regulated family generates exactly one evolution, so `V` is the evolution of `H` on the
  -- rounded clock.
  have hreg : IsRegulated G 0 T := by
    have := isRegulated_of_piecewise_constant G t A (T + 1) hG
    simpa only [ht0, htend] using this
  have hend : evolutionOf G T T = V T :=
    generates_unique dieudonne_10_5_4 hreg (generates_evolutionOf_of_exists ⟨V, hV'⟩) hV'
      ⟨by positivity, le_rfl⟩
  calc
    roundedEvolution H T T = durationProduct len A (T + 1) := by
      -- First equality of (2.5): equation (2.4) for `H(⌊t+1/2⌋/T)`.
      rw [roundedEvolution]
      change evolutionOf G T T = _
      exact hend.trans hproduct
    _ = frozenEvolution (H 1) (1 / 2) * stepProduct H T *
        frozenEvolution (H 0) (-1 / 2) := by
      -- Second equality of (2.5): `e^{-iH(0)/2} = e^{-iH(0)} e^{iH(0)/2}`, and Definition 2.3.
      rw [show len = roundedClockDuration T from rfl,
        show A = fun j : ℕ ↦ H (j / T) from rfl,
        rounded_durationProduct_split H T hT,
        durationProduct_one_eq_stepProduct]
    _ = exp (-(I / 2) • H 1) * stepProduct H T * exp ((I / 2) • H 0) := by
      -- The two end factors, written as in the statement.
      have hleft : frozenEvolution (H 1) (1 / 2) = exp (-(I / 2) • H 1) := by
        rw [frozenEvolution_eq]
        congr 1
        norm_num
        ring_nf
      have hright : frozenEvolution (H 0) (-1 / 2) = exp ((I / 2) • H 0) := by
        rw [frozenEvolution_eq]
        congr 1
        norm_num
        ring_nf
      rw [hleft, hright]

open scoped MatrixOrder in
/-- Orthogonal projectors are contractions in the operator norm. -/
private theorem projector_norm_le_one {P : 𝕄} (hP : IsOrthogonalProjector P) : ‖P‖ ≤ 1 := by
  letI := matrixCStarAlgebra d
  exact (CStarAlgebra.norm_le_one_iff_of_nonneg P hP.nonneg).mpr hP.le_one

/-- The three-term identity in Proposition 2.4. -/
private theorem transfer_identity (P Q P' Q' U W A B : 𝕄) :
    (1 - Q') * A * W * B * P' - (1 - Q) * U * P =
      (1 - Q') * (A * W * B - U) * P' +
        (Q - Q') * U * P + (1 - Q') * U * (P' - P) := by
  noncomm_ring

/-- Commuting unitary endpoint phases do not change the leakage norm. -/
private theorem transfer_phase_norm {P' Q' A B : 𝕄} (W : 𝕄)
    (hA : IsUnitary A) (hB : IsUnitary B) (hAQ' : Commute A Q')
    (hBP' : Commute B P') :
    ‖(1 - Q') * A * W * B * P'‖ = ‖(1 - Q') * W * P'‖ := by
  have hleft : (1 - Q') * A = A * (1 - Q') := by
    simp only [sub_mul, mul_sub, one_mul, mul_one, hAQ'.eq]
  have hmove : (1 - Q') * A * W * B * P' = A * ((1 - Q') * W * P') * B := by
    rw [hleft]
    simp only [mul_assoc, hBP'.eq]
  rw [hmove, CStarRing.norm_mul_mem_unitary _ hB,
    CStarRing.norm_mem_unitary_mul _ hA]

/-- **Proposition 2.4.** Let `P`, `P'`, and `Q'` be orthogonal projectors, let `Q`, `U`, and `W` be
matrices, and let `A` and `B` be unitary matrices that commute with `Q'` and `P'`, respectively.
Then
`|‖(1 - Q') W P'‖ - ‖(1 - Q) U P‖| ≤ ‖A W B - U‖ + ‖U‖ (‖P' - P‖ + ‖Q' - Q‖)`.

Here `P'` and `Q'` are the paper's `P̃` and `Q̃`. -/
theorem transfer [NeZero d] {P Q P' Q' U W A B : 𝕄} (hP : IsOrthogonalProjector P)
    (hP' : IsOrthogonalProjector P')
    (hQ' : IsOrthogonalProjector Q') (hA : IsUnitary A) (hB : IsUnitary B)
    (hAQ' : Commute A Q') (hBP' : Commute B P') :
    |‖(1 - Q') * W * P'‖ - ‖(1 - Q) * U * P‖| ≤
      ‖A * W * B - U‖ + ‖U‖ * (‖P' - P‖ + ‖Q' - Q‖) := by
  -- The commutation gives `‖(1 - Q')AWBP'‖ = ‖(1 - Q')WP'‖`.
  have hphase := transfer_phase_norm W hA hB hAQ' hBP'
  -- Projectors are contractions, which bounds the three terms of the identity.
  have hPc := projector_norm_le_one hP
  have hP'c := projector_norm_le_one hP'
  have hQ'c := projector_norm_le_one hQ'.one_sub
  have herror : ‖(1 - Q') * (A * W * B - U) * P'‖ ≤ ‖A * W * B - U‖ := by
    simpa only [one_mul, mul_one] using
      norm_mul_le_of_le (norm_mul_le_of_le hQ'c (le_refl ‖A * W * B - U‖)) hP'c
  have hfinal : ‖(Q - Q') * U * P‖ ≤ ‖Q' - Q‖ * ‖U‖ := by
    simpa only [mul_one, norm_sub_rev] using
      norm_mul_le_of_le (norm_mul_le (Q - Q') U) hPc
  have hinitial : ‖(1 - Q') * U * (P' - P)‖ ≤ ‖U‖ * ‖P' - P‖ := by
    simpa only [one_mul] using
      norm_mul_le_of_le (norm_mul_le_of_le hQ'c (le_refl ‖U‖)) (le_refl ‖P' - P‖)
  calc
    _ = |‖(1 - Q') * A * W * B * P'‖ - ‖(1 - Q) * U * P‖| := by rw [hphase]
    _ ≤ ‖(1 - Q') * A * W * B * P' - (1 - Q) * U * P‖ :=
      -- the reverse triangle inequality
      abs_norm_sub_norm_le _ _
    _ = ‖(1 - Q') * (A * W * B - U) * P' +
          (Q - Q') * U * P + (1 - Q') * U * (P' - P)‖ := by
      -- the identity of the paper's proof
      rw [transfer_identity]
    _ ≤ ‖A * W * B - U‖ + ‖Q' - Q‖ * ‖U‖ + ‖U‖ * ‖P' - P‖ :=
      norm_add_le_of_le (norm_add_le_of_le herror hfinal) hinitial
    _ = _ := by ring

end RoundedClocks
