module

public import UnitaryProducts.Prose.UnitStepsCorrector
public import UnitaryProducts.Prose.Introduction
public import UnitaryProducts.Paper.SpectralWindow

/-! # The paper's Hamiltonians, regularity, spectral widths and evolutions -/

@[expose] public section
open Set Real Complex Filter
open UnitaryProducts.Paper.UnitStepsProse
open scoped Topology Matrix.Norms.L2Operator
noncomputable section
namespace UnitaryProducts.Paper
variable {d : ℕ}
local notation "𝕄" => Matrix (Fin d) (Fin d) ℂ

/-- Section 2: "A time-dependent Hamiltonian is a Hermitian family" on `[0,1]`. -/
def IsTimeDepHamiltonian (H : ℝ → 𝕄) : Prop :=
  ∀ s ∈ Icc (0 : ℝ) 1, (H s).IsHermitian

/-- Theorem 4.2: "differentiable ... with one-sided derivatives at s=0 and s=1",
with the displayed Lipschitz bound on the derivative. -/
def HasLipschitzDerivative (H Hd : ℝ → 𝕄) (L : ℝ) : Prop :=
  (∀ s ∈ Icc (0 : ℝ) 1, HasDerivWithinAt H (Hd s) (Icc 0 1) s) ∧
  ∀ s ∈ Icc (0 : ℝ) 1, ∀ t ∈ Icc (0 : ℝ) 1, ‖Hd t - Hd s‖ ≤ L * |t - s|

/-- Theorem 4.2: "eigenvalue differences have modulus at most a width".
The real-spectrum formulation has no Hermitian proof argument; its use for
Hamiltonians is justified by `hasSpectralWidth_iff`. -/
def HasSpectralWidth (A : 𝕄) (w : ℝ) : Prop :=
  ∀ x ∈ spectrum ℝ A, ∀ y ∈ spectrum ℝ A, |x - y| ≤ w

/-- For a Hermitian matrix, spectral width is exactly the eigenvalue-difference
condition of Theorem 4.2. -/
theorem hasSpectralWidth_iff {A : 𝕄} (hA : A.IsHermitian) {w : ℝ} :
    HasSpectralWidth A w ↔ ∀ p q, |hA.eigenvalues p - hA.eigenvalues q| ≤ w := by
  simp only [HasSpectralWidth, hA.spectrum_real_eq_range_eigenvalues,
    forall_mem_range]

/-- Theorem 4.2: "samples H(j/T) for 0≤j≤T" have the prescribed width. -/
def HasSampleWidth (H : ℝ → 𝕄) (T : ℕ) (w : ℝ) : Prop :=
  ∀ j : ℕ, j ≤ T → HasSpectralWidth (H ((j : ℝ) / T)) w

/-- Theorem 4.6: "every H(s) with eigenvalue differences of modulus at most" `w`. -/
def HasWidth (H : ℝ → 𝕄) (w : ℝ) : Prop :=
  ∀ s ∈ Icc (0 : ℝ) 1, HasSpectralWidth (H s) w

/-- The sample-width vocabulary unfolds to the former eigenvalue hypotheses. -/
theorem hasSampleWidth_iff {H : ℝ → 𝕄} (hH : IsTimeDepHamiltonian H)
    {T : ℕ} {w : ℝ} : HasSampleWidth H T w ↔
      ∀ j : ℕ, ∀ hj : j ≤ T, ∀ p q,
        |(hH _ (walkCubic_sample hj)).eigenvalues p -
          (hH _ (walkCubic_sample hj)).eigenvalues q| ≤ w := by
  constructor
  · intro h j hj
    exact (hasSpectralWidth_iff (hH _ (walkCubic_sample hj))).1 (h j hj)
  · intro h j hj
    exact (hasSpectralWidth_iff (hH _ (walkCubic_sample hj))).2 (h j hj)

/-- The all-time width vocabulary unfolds to the former eigenvalue hypotheses. -/
theorem hasWidth_iff {H : ℝ → 𝕄} (hH : IsTimeDepHamiltonian H) {w : ℝ} :
    HasWidth H w ↔ ∀ s (hs : s ∈ Icc (0 : ℝ) 1) p q,
      |(hH s hs).eigenvalues p - (hH s hs).eigenvalues q| ≤ w := by
  constructor
  · intro h s hs
    exact (hasSpectralWidth_iff (hH s hs)).1 (h s hs)
  · intro h s hs
    exact (hasSpectralWidth_iff (hH s hs)).2 (h s hs)

/-- The differentiability in Theorem 4.2 gives the continuity needed for evolution. -/
theorem HasLipschitzDerivative.continuousOn {H Hd : ℝ → 𝕄} {L : ℝ}
    (h : HasLipschitzDerivative H Hd L) : ContinuousOn H (Icc 0 1) :=
  fun s hs ↦ (h.1 s hs).continuousWithinAt

/-- Section 2, equation (2.1): the "evolution" generated by `G` on `[0,T]`.
Choice selects an existing solution; the value is `1` when none exists.
The existence and uniqueness lemmas below are used only under the paper's hypotheses. -/
def generatedEvolution (G : ℝ → 𝕄) (T : ℝ) : ℝ → 𝕄 :=
  open Classical in
  if h : ∃ U, IsEvolution G U 0 T then h.choose else fun _ ↦ 1

/-- The selected evolution satisfies equation (2.1) whenever a solution exists. -/
theorem generatedEvolution_spec {G : ℝ → 𝕄} {T : ℝ}
    (h : ∃ U, IsEvolution G U 0 T) :
    IsEvolution G (generatedEvolution G T) 0 T := by
  simpa only [generatedEvolution, dif_pos h] using h.choose_spec

/-- Section 2: "exactly one evolution", with equality on its domain `[0,T]`. -/
theorem generatedEvolution_eqOn {G U : ℝ → 𝕄} {T : ℝ} (hT : 0 < T)
    (hG : ∀ t ∈ Icc 0 T, (G t).IsHermitian) (hr : IsRegulated G 0 T)
    (hU : IsEvolution G U 0 T) : EqOn U (generatedEvolution G T) (Icc 0 T) := by
  obtain ⟨V, hV, huniq, _⟩ := regulated_evolution hT hG hr
  have he := generatedEvolution_spec ⟨V, hV⟩
  exact fun t ht ↦ (huniq U hU ht).trans (huniq _ he ht).symm

/-- Section 2: "Its evolution over time T>0" is generated by `H(t/T)`. -/
def evolution (H : ℝ → 𝕄) (T : ℝ) : ℝ → 𝕄 :=
  generatedEvolution (fun t ↦ H (t / T)) T

/-- The evolution of a regulated time-dependent Hamiltonian satisfies (2.1). -/
theorem evolution_spec {H : ℝ → 𝕄} {T : ℝ} (hT : 0 < T)
    (hH : IsTimeDepHamiltonian H) (hr : IsRegulated H 0 1) :
    IsEvolution (fun t ↦ H (t / T)) (evolution H T) 0 T := by
  obtain ⟨U, hU, _⟩ := regulated_evolution hT
    (fun _ ht ↦ hH _ ⟨div_nonneg ht.1 hT.le, (div_le_one hT).mpr ht.2⟩)
    (regulated_rescale hT hr)
  exact generatedEvolution_spec ⟨U, hU⟩

/-- Section 2 uniqueness identifies any solution with `evolution` on `[0,T]`. -/
theorem evolution_eqOn {H U : ℝ → 𝕄} {T : ℝ} (hT : 0 < T)
    (hH : IsTimeDepHamiltonian H) (hr : IsRegulated H 0 1)
    (hU : IsEvolution (fun t ↦ H (t / T)) U 0 T) :
    EqOn U (evolution H T) (Icc 0 T) :=
  generatedEvolution_eqOn hT
    (fun _ ht ↦ hH _ ⟨div_nonneg ht.1 hT.le, (div_le_one hT).mpr ht.2⟩)
    (regulated_rescale hT hr) hU

/-- Section 2, equation (2.5): the "evolution" of `H(⌊t+1/2⌋/T)`.
`sample T (t/T)` is that clock, as `roundedEvolution_clock` records. -/
def roundedEvolution (H : ℝ → 𝕄) (T : ℕ) : ℝ → 𝕄 :=
  generatedEvolution (fun t ↦ H (sample T (t / T))) T

/-- The sampled and floor expressions for the rounded clock agree. -/
theorem roundedEvolution_clock {T : ℕ} (hT : 0 < T) (t : ℝ) :
    sample T (t / T) = (⌊t + 1 / 2⌋ : ℝ) / T := by
  have hn : (T : ℝ) ≠ 0 := (Nat.cast_pos.mpr hT).ne'
  simp only [sample, clock, mul_div_cancel₀ _ hn]

/-- The generator of `roundedEvolution` is regulated, as stated before (2.5). -/
theorem roundedEvolution_regulated (H : ℝ → 𝕄) {T : ℕ} (hT : 0 < T) :
    IsRegulated (fun t ↦ H (sample T (t / T))) 0 T := by
  simpa only [roundedEvolution_clock hT] using
    rounded_hamiltonian_regulated H T

/-- The rounded evolution satisfies (2.1), without regularity assumptions on `H`. -/
theorem roundedEvolution_spec {H : ℝ → 𝕄} {T : ℕ} (hT : 0 < T)
    (hH : IsTimeDepHamiltonian H) :
    IsEvolution (fun t ↦ H (sample T (t / T))) (roundedEvolution H T) 0 T := by
  have ht : (0 : ℝ) < T := Nat.cast_pos.mpr hT
  obtain ⟨V, hV, _⟩ := regulated_evolution ht
    (fun t ht' ↦ hH _ (sample_mem (N := T)
      ⟨div_nonneg ht'.1 ht.le, (div_le_one ht).mpr ht'.2⟩))
    (roundedEvolution_regulated H hT)
  exact generatedEvolution_spec ⟨V, hV⟩

/-- Uniqueness identifies any rounded-clock solution on `[0,T]`. -/
theorem roundedEvolution_eqOn {H V : ℝ → 𝕄} {T : ℕ} (hT : 0 < T)
    (hH : IsTimeDepHamiltonian H)
    (hV : IsEvolution (fun t ↦ H (sample T (t / T))) V 0 T) :
    EqOn V (roundedEvolution H T) (Icc 0 T) := by
  have ht : (0 : ℝ) < T := Nat.cast_pos.mpr hT
  exact generatedEvolution_eqOn ht
    (fun t ht' ↦ hH _ (sample_mem (N := T)
      ⟨div_nonneg ht'.1 ht.le, (div_le_one ht).mpr ht'.2⟩))
    (roundedEvolution_regulated H hT) hV

/-- Equation (2.5): the rounded evolution ends at the phased unit-step product. -/
theorem roundedEvolution_endpoint {H : ℝ → 𝕄} {T : ℕ} (hT : 0 < T)
    (hH : IsTimeDepHamiltonian H) :
    roundedEvolution H T T = UnitaryProducts.evol (H 1) (1 / 2) *
      (unitProduct H T).1 * UnitaryProducts.evol (H 0) (-(1 / 2)) := by
  have ht : (0 : ℝ) < T := Nat.cast_pos.mpr hT
  have h := regulated_evolution_rounded.2 H hH T T ht hT
    (roundedEvolution H T) (by
      simpa only [sample, clock, mul_div_assoc] using roundedEvolution_spec hT hH)
  have hhalf : (T : ℝ) / (2 * T) = 1 / 2 := by field_simp
  simpa only [hhalf, div_self ht.ne', one_smul] using h

/-- Theorem 4.6 and Fact B.2: "coefficients are O((2π-w)⁻³) as w→2π". -/
def HasInverseCubeGrowth (f : ℝ → ℝ) : Prop :=
  Asymptotics.IsBigO (𝓝[>] 0) (fun δ ↦ f (2 * π - δ)) (fun δ : ℝ ↦ 1 / δ ^ 3)

/-- Theorem 4.7: "a ... unitary family ... [has] a band" with the displayed
ordered endpoints and "eigenphase gap ... continuous in s". Fixed rank is not
needed by the comparison, so it is not part of this predicate. -/
def HasUnitaryBand (W : ℝ → 𝕄) (α β : ℝ → ℝ) : Prop :=
  (walk W 1).1 ∧
  (∀ s ∈ Icc (0 : ℝ) 1, α s < β s ∧ β s < α s + 2 * π) ∧
  spectralWindowFamily true W α β ∧
  ContinuousOn (fun s ↦ spectralWindowGap true (W s) (α s) (β s)) (Icc 0 1)

/-- Theorem 4.7: "the Hermitian H(s) with e^{-iH(s)}=W(s) and spectrum in
(α(s),α(s)+2π)". The final clause explicitly states its pointwise uniqueness. -/
def IsBandLogarithm (W : ℝ → 𝕄) (α : ℝ → ℝ) (H : ℝ → 𝕄) : Prop :=
  IsTimeDepHamiltonian H ∧
  (∀ s ∈ Icc (0 : ℝ) 1, UnitaryProducts.evol (H s) 1 = W s) ∧
  (∀ s ∈ Icc (0 : ℝ) 1, ∀ x ∈ spectrum ℝ (H s), x ∈ Ioo (α s) (α s + 2 * π)) ∧
  ∀ s ∈ Icc (0 : ℝ) 1, ∀ (B : 𝕄), B.IsHermitian →
    (∀ x ∈ spectrum ℝ B, x ∈ Ioo (α s) (α s + 2 * π)) →
    UnitaryProducts.evol B 1 = W s → B = H s

end UnitaryProducts.Paper
