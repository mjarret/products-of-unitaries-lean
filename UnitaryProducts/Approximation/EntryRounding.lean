module

public import UnitaryProducts.Evolution.Simulation

/-!
# Entry rounding is not uniform in time

## Declarations

- `entry_rounding_obstruction`
- `entry_rounding_obstruction_two`
- `evol_diagonal`
- `norm_exp_I_mul_sub_exp_I_mul`
-/

@[expose] public section

open scoped Matrix.Norms.L2Operator
open Complex

noncomputable section

namespace UnitaryProducts.Paper

/-- The evolution of a constant diagonal Hamiltonian is the diagonal matrix of phases. -/
private theorem evol_diagonal {d : ℕ} (v : Fin d → ℂ) (u : ℝ) :
    UnitaryProducts.evol (Matrix.diagonal v) u =
      Matrix.diagonal (fun i ↦ Complex.exp ((u : ℂ) * (-I * v i))) := by
  rw [UnitaryProducts.evol, ← Matrix.diagonal_smul, ← Matrix.diagonal_smul, Matrix.exp_diagonal]
  congr 1
  funext i
  rw [Pi.coe_exp, ← Complex.exp_eq_exp_ℂ, Pi.smul_apply, Pi.smul_apply, smul_eq_mul,
    Complex.real_smul]

/-- Two phases on the unit circle are at distance `2|sin((x-y)/2)|`. -/
private theorem norm_exp_I_mul_sub_exp_I_mul (x y : ℝ) :
    ‖Complex.exp (I * x) - Complex.exp (I * y)‖ = 2 * |Real.sin ((x - y) / 2)| := by
  have h : Complex.exp (I * x) - Complex.exp (I * y) =
      Complex.exp (I * y) * (Complex.exp (I * ↑(x - y)) - 1) := by
    rw [mul_sub, mul_one, ← Complex.exp_add]
    congr 2; push_cast; ring
  rw [h, norm_mul, Complex.norm_exp_I_mul_ofReal, one_mul,
    Complex.norm_exp_I_mul_ofReal_sub_one, norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_two]

/-- Supports the claim of §5 that "the evolutions generated by the constant Hamiltonians
$\mathrm{diag}(a,-a)$ and $\mathrm{diag}(b,-b)$, for any rounding $b\ne a$ of $a$, differ at time
$T$ by $2|\sin(T(a-b)/2)|$ in norm"; the identity holds for all real $a$, $b$, and $T$. Its value
$2$ at $T=\pi/|a-b|$ is `entry_rounding_obstruction_two`.

Reading the statement against the paper:
* `UnitaryProducts.evol G T` is `exp (T • (-I • G))`, that is $e^{-iTG}$, and the norm is the
  $\ell^2$ operator norm.
* The identity holds for all real `a`, `b`, `T`; the paper's "rounding $b\ne a$ of $a$" is not
  needed.

The proof is the computation behind the paper's value: (1) $e^{-iT\,\mathrm{diag}(v)}$ is the
diagonal matrix of the phases $e^{-iTv_p}$; (2) two unit phases are at distance
$|e^{ix}-e^{iy}|=2|\sin((x-y)/2)|$, so both diagonal entries of the difference have modulus
$2|\sin(T(a-b)/2)|$; (3) the operator norm of a diagonal matrix is the largest modulus of its
entries. -/
theorem entry_rounding_obstruction (a b T : ℝ) :
    ‖UnitaryProducts.evol (Matrix.diagonal ![(a : ℂ), -(a : ℂ)]) T -
        UnitaryProducts.evol (Matrix.diagonal ![(b : ℂ), -(b : ℂ)]) T‖ =
      2 * |Real.sin (T * (a - b) / 2)| := by
  -- Step 2: the entries e^{-iTa} - e^{-iTb} and e^{iTa} - e^{iTb} both have modulus
  -- 2|sin(T(a-b)/2)| (two-phase distance; sin is odd for the first).
  have e0 : ‖Complex.exp ((T : ℂ) * (-I * a)) - Complex.exp ((T : ℂ) * (-I * b))‖ =
      2 * |Real.sin (T * (a - b) / 2)| := by
    have h1 : (T : ℂ) * (-I * a) = I * ↑(-(T * a)) := by push_cast; ring
    have h2 : (T : ℂ) * (-I * b) = I * ↑(-(T * b)) := by push_cast; ring
    rw [h1, h2, norm_exp_I_mul_sub_exp_I_mul,
      show (-(T * a) - -(T * b)) / 2 = -(T * (a - b) / 2) by ring, Real.sin_neg, abs_neg]
  have e1 : ‖Complex.exp ((T : ℂ) * (-I * -(a : ℂ))) - Complex.exp ((T : ℂ) * (-I * -(b : ℂ)))‖ =
      2 * |Real.sin (T * (a - b) / 2)| := by
    have h1 : (T : ℂ) * (-I * -(a : ℂ)) = I * ↑(T * a) := by push_cast; ring
    have h2 : (T : ℂ) * (-I * -(b : ℂ)) = I * ↑(T * b) := by push_cast; ring
    rw [h1, h2, norm_exp_I_mul_sub_exp_I_mul, show (T * a - T * b) / 2 = T * (a - b) / 2 by ring]
  -- Steps 1 and 3: the difference of the evolutions is diagonal, and the ℓ² operator norm of a
  -- diagonal matrix is the sup norm of its diagonal.
  rw [evol_diagonal, evol_diagonal, Matrix.diagonal_sub, Matrix.l2_opNorm_diagonal]
  have hentry : ∀ i : Fin 2,
      ‖Complex.exp ((T : ℂ) * (-I * ![(a : ℂ), -(a : ℂ)] i)) -
          Complex.exp ((T : ℂ) * (-I * ![(b : ℂ), -(b : ℂ)] i))‖ =
        2 * |Real.sin (T * (a - b) / 2)| := by
    -- The two diagonal entries `i = 0, 1` of the 2 × 2 matrix, proved above as `e0` and `e1`.
    intro i; fin_cases i; exacts [e0, e1]
  -- Both entries have the same modulus, so the sup norm equals it.
  refine le_antisymm ((pi_norm_le_iff_of_nonneg (by positivity)).2 fun i ↦ (hentry i).le) ?_
  exact (hentry 0).symm.le.trans (norm_le_pi_norm (fun i : Fin 2 ↦
    Complex.exp ((T : ℂ) * (-I * ![(a : ℂ), -(a : ℂ)] i)) -
      Complex.exp ((T : ℂ) * (-I * ![(b : ℂ), -(b : ℂ)] i))) 0)

/-- Supports the claim of §5 that the distance $2|\sin(T(a-b)/2)|$ between the evolutions
generated by $\mathrm{diag}(a,-a)$ and $\mathrm{diag}(b,-b)$, for $b\ne a$,
"is $2$ at $T=\pi/|a-b|$".

Reading the statement against the paper:
* `a ≠ b` is the paper's $b\ne a$, and the first conjunct records that $T=\pi/|a-b|$ is a
  positive time.

The proof substitutes $T=\pi/|a-b|$ into `entry_rounding_obstruction`: for either sign of $a-b$,
$T(a-b)/2=\pm\pi/2$, and $2|\sin(\pm\pi/2)|=2$. -/
theorem entry_rounding_obstruction_two {a b : ℝ} (hab : a ≠ b) :
    0 < Real.pi / |a - b| ∧
      ‖UnitaryProducts.evol (Matrix.diagonal ![(a : ℂ), -(a : ℂ)]) (Real.pi / |a - b|) -
          UnitaryProducts.evol (Matrix.diagonal ![(b : ℂ), -(b : ℂ)]) (Real.pi / |a - b|)‖ = 2 := by
  have hne : a - b ≠ 0 := sub_ne_zero.2 hab
  refine ⟨div_pos Real.pi_pos (abs_pos.2 hne), ?_⟩
  rw [entry_rounding_obstruction]
  rcases hne.lt_or_gt with h | h
  · rw [abs_of_neg h, div_neg, neg_mul, div_mul_cancel₀ _ hne, neg_div, Real.sin_neg, abs_neg,
      Real.sin_pi_div_two, abs_one, mul_one]
  · rw [abs_of_pos h, div_mul_cancel₀ _ hne, Real.sin_pi_div_two, abs_one, mul_one]

end UnitaryProducts.Paper
