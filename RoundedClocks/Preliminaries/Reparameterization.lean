module

public import RoundedClocks.Preliminaries.Regulated

/-!
# The change of variable `s = t/T`

Section 2: "With `s = t/T`, `U(Ts)` for `s ∈ [0,1]` is generated by `T H(s)`, so `U(T)` depends
only on `T H`." The evolution of `H` over time `T` is generated by `H(t/T)` for `t ∈ [0,T]`, a
regulated family when `H` is regulated (`IsRegulated.comp_div`), and `s ↦ U(Ts)` is the evolution
generated by `T H(s)` for `s ∈ [0,1]` (`generates_reparameterized`).
-/

@[expose] public section

open scoped Matrix.Norms.L2Operator Topology
open Set Filter
open Complex (I)

namespace RoundedClocks

variable {d : ℕ}

local notation "𝕄" => Matrix (Fin d) (Fin d) ℂ

/-- If `A(s)` is regulated for `s ∈ [0,1]` and `T > 0`, then `A(t/T)` is regulated for
`t ∈ [0,T]`. -/
theorem IsRegulated.comp_div {A : ℝ → 𝕄} {T : ℝ} (hT : 0 < T)
    (hA : IsRegulated A 0 1) : IsRegulated (fun t ↦ A (t / T)) 0 T := by
  constructor
  · intro t ht
    obtain ⟨L, hL⟩ := hA.1 (t / T)
      ⟨div_nonneg ht.1 hT.le, (div_lt_one hT).2 ht.2⟩
    refine ⟨L, hL.comp ?_⟩
    exact (continuous_id.div_const T).continuousWithinAt.tendsto_nhdsWithin
      (fun _ hx ↦ (div_lt_div_iff_of_pos_right hT).2 hx)
  · intro t ht
    obtain ⟨L, hL⟩ := hA.2 (t / T)
      ⟨div_pos ht.1 hT, (div_le_one hT).2 ht.2⟩
    refine ⟨L, hL.comp ?_⟩
    exact (continuous_id.div_const T).continuousWithinAt.tendsto_nhdsWithin
      (fun _ hx ↦ (div_lt_div_iff_of_pos_right hT).2 hx)

/-- Section 2: with `s = t/T`, if `A(t/T)` for `t ∈ [0,T]` generates `V`, then `T A(s)` for
`s ∈ [0,1]` generates `V(Ts)`. -/
theorem generates_reparameterized {A V : ℝ → 𝕄} {T : ℝ} (hT : 0 < T)
    (hV : Generates (fun t ↦ A (t / T)) V 0 T) :
    Generates (fun s ↦ T • A s) (fun s ↦ V (T * s)) 0 1 := by
  -- The map `s ↦ Ts` takes `[0,1]` to `[0,T]`.
  have hmap : MapsTo (fun x : ℝ ↦ T * x) (Icc 0 1) (Icc 0 T) := fun x hx ↦
    ⟨mul_nonneg hT.le hx.1, (mul_le_iff_le_one_right hT).2 hx.2⟩
  refine ⟨hV.continuousOn.comp (continuousOn_const.mul continuousOn_id) hmap, ?_,
    fun s hs ↦ hV.isUnitary (T * s) (hmap hs), ?_⟩
  · simpa using hV.init
  · -- The chain rule: `(V(Ts))' = T V'(Ts) = -i (T A(s)) V(Ts)` when `Ts` is not exceptional.
    obtain ⟨S, hS, hd⟩ := hV.deriv
    refine ⟨(fun s : ℝ ↦ T * s) ⁻¹' S,
      hS.preimage (fun x y hxy ↦ mul_left_cancel₀ hT.ne' hxy), fun s hs hsS ↦ ?_⟩
    have hd' := (hd (T * s) (hmap hs) hsS).scomp s
      (hasDerivAt_const_mul T).hasDerivWithinAt hmap
    rw [smul_comm T (-I)] at hd'
    simpa only [Function.comp_apply, mul_div_cancel_left₀ _ hT.ne', Matrix.smul_mul, smul_smul,
      Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg, neg_mul, mul_assoc] using hd'

end RoundedClocks
