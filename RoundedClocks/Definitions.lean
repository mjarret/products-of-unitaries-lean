module

public import Mathlib

/-!
# Definitions of the paper

Every term that a statement of the paper uses is defined here, in the paper's order and in the
paper's words. The statements themselves are in the files named after the paper's sections.

Throughout, `𝕄` is the type of `d × d` complex matrices, `‖·‖` is the operator norm, and `A†` is
the conjugate transpose of `A`.

## Notation

* `A†` : the conjugate transpose of the matrix `A`.
* `∂f` : the derivative `f'` of `f` in `[0,1]`, one-sided at `0` and at `1`; `∂∂f` is `f''`.
* `‖f‖∞` : the supremum of `‖f s‖` over `s ∈ [0,1]`.
* `𝒩`, `c₀`, `c₁`, `c₂`, `κ`, `ℰ`, `ℰtilde` : the multiplier of Definition 4.1 and the constants of
  Appendix B. The script letter `𝒩` is not Mathlib's neighbourhood filter `𝓝`.

## Conventions

Lean's functions are total, so some definitions take a value where the paper's term is undefined.
None of these cases arises under the hypotheses of the statements, and each statement's docstring
gives its hypotheses in the paper's words.

* The dimension `d` is at least `1` in the paper; statements that need it assume `[NeZero d]`.
* `evolutionOf G T` is the constant `1` when `G` generates no evolution on `[0,T]`. Every regulated
  Hermitian family generates exactly one.
* `spectralGap`, `eigenphaseGap`, and `leastEigenvalueGap` are infima; the infimum of an empty set
  of real numbers is `0`.
* `‖f‖∞` is a supremum; it is `0` when `‖f‖` is unbounded on `[0,1]`.
* `𝒩([Ω,·])E` is `0` unless `Ω` is Hermitian with eigenvalue differences of modulus less than `2π`.
-/

@[expose] public section

open scoped Matrix.Norms.L2Operator Topology Real
open Set Filter
open Complex (I)
open NormedSpace (exp)

noncomputable section

namespace RoundedClocks

variable {d : ℕ}

local notation "𝕄" => Matrix (Fin d) (Fin d) ℂ

/-- `A†` is the conjugate transpose of `A`. -/
scoped postfix:max "†" => star

/-- The derivative of `f` in `[0,1]`, one-sided at `0` and at `1`. -/
def deriv01 {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (f : ℝ → E) : ℝ → E :=
  derivWithin f (Set.Icc (0 : ℝ) 1)

/-- `∂f` is the derivative of `f` in `[0,1]`, one-sided at `0` and at `1`. -/
scoped prefix:max "∂" => deriv01

/-- Section 2: `‖f‖∞ = sup_{s ∈ [0,1]} ‖f s‖`. -/
def supNorm {E : Type*} [NormedAddCommGroup E] (f : ℝ → E) : ℝ :=
  sSup ((fun s ↦ ‖f s‖) '' Icc (0 : ℝ) 1)

@[inherit_doc] scoped notation "‖" f "‖∞" => supNorm f

/-! ## Section 2: regulated functions, evolutions, products, and bands -/

/-- **Definition 2.1.** A matrix-valued function `H(t)` with `t ∈ [a,b]` is *regulated* if `H` has
a right limit at every `t ∈ [a,b)` and a left limit at every `t ∈ (a,b]`. -/
def IsRegulated (H : ℝ → 𝕄) (a b : ℝ) : Prop :=
  (∀ t ∈ Ico a b, ∃ L, Tendsto H (𝓝[>] t) (𝓝 L)) ∧
    ∀ t ∈ Ioc a b, ∃ L, Tendsto H (𝓝[<] t) (𝓝 L)

/-- A matrix `A` is *unitary* if `A† A = 1`. For square matrices this gives `A A† = 1` too. -/
abbrev IsUnitary (A : 𝕄) : Prop := A† * A = 1

/-- An *orthogonal projector* is a matrix `P` with `P² = P = P†`. -/
abbrev IsOrthogonalProjector (P : 𝕄) : Prop := IsStarProjection P

/-- Equation (2.1). A family `G(t)` with `t ∈ [a,b]` *generates* the *evolution* `V(t)` for
`t ∈ [a,b]` if `V` is continuous and unitary-valued, `V(a) = 1`, and `i V'(t) = G(t) V(t)` for all
but countably many `t`. The derivative is taken in `[a,b]`, so it is one-sided at `a` and `b`. -/
def Generates (G V : ℝ → 𝕄) (a b : ℝ) : Prop :=
  ContinuousOn V (Icc a b) ∧ V a = 1 ∧ (∀ t ∈ Icc a b, IsUnitary (V t)) ∧
    ∃ S : Set ℝ, S.Countable ∧
      ∀ t ∈ Icc a b, t ∉ S → HasDerivWithinAt V (-I • (G t * V t)) (Icc a b) t

/-- The evolution on `[0,T]` that `G` generates. A regulated Hermitian family generates exactly
one evolution (`generates_evolutionOf`, `eqOn_evolutionOf`). For a family that generates no
evolution, the value is the constant `1`. -/
def evolutionOf (G : ℝ → 𝕄) (T : ℝ) : ℝ → 𝕄 :=
  open Classical in if h : ∃ V, Generates G V 0 T then h.choose else fun _ ↦ 1

/-- Section 2. A *time-dependent Hamiltonian* is a Hermitian family `H(s)` with `s ∈ [0,1]`. -/
def IsTimeDepHamiltonian (H : ℝ → 𝕄) : Prop :=
  ∀ s ∈ Icc (0 : ℝ) 1, (H s).IsHermitian

/-- Section 2. The *evolution* `U` of a time-dependent Hamiltonian `H` over time `T > 0` is the
evolution `U(t)` for `t ∈ [0,T]` generated by `H(t/T)`. Its final value is `evolution H T T`. -/
def evolution (H : ℝ → 𝕄) (T : ℝ) : ℝ → 𝕄 :=
  evolutionOf (fun t ↦ H (t / T)) T

/-- The product `W((T-1)/T) ⋯ W(1/T) W(0)` of the `T` samples of a family `W`. -/
def sampleProduct (W : ℝ → 𝕄) (T : ℕ) : 𝕄 :=
  ((List.range T).reverse.map fun j : ℕ ↦ W (j / T)).prod

/-- **Definition 2.3.** For a time-dependent Hamiltonian `H(s)` with `s ∈ [0,1]` and an integer
`T ≥ 1`, the *`T`-step product* of `H` is `W_T = e^{-iH((T-1)/T)} ⋯ e^{-iH(0)}`. -/
def stepProduct (H : ℝ → 𝕄) (T : ℕ) : 𝕄 :=
  sampleProduct (fun s ↦ exp (-I • H s)) T

/-- Section 2. The evolution `V` generated by `H(⌊t+1/2⌋/T)` for `t ∈ [0,T]`: the Hamiltonian `H`
run on the rounded clock `⌊t+1/2⌋`. By the rounded-clock identity (2.5),
`V(T) = e^{-iH(1)/2} W_T e^{iH(0)/2}` (`roundedEvolution_eq`). -/
def roundedEvolution (H : ℝ → 𝕄) (T : ℕ) : ℝ → 𝕄 :=
  evolutionOf (fun t ↦ H ((⌊t + 1 / 2⌋ : ℝ) / T)) T

/-- The real numbers `{λ : a < λ < b}`, as a set of complex numbers. -/
def interval (a b : ℝ) : Set ℂ := (fun x : ℝ ↦ (x : ℂ)) '' Ioo a b

/-- The arc `{e^{-iθ} : a < θ < b}` of the unit circle. -/
def arc (a b : ℝ) : Set ℂ := (fun θ : ℝ ↦ Complex.exp (-I * (θ : ℂ))) '' Ioo a b

/-- **Definition 2.5(i).** If `A` is Hermitian, a *band* of `A` is a nonempty proper subset of its
eigenvalues of the form `{λ : a < λ < b}`, where `a` and `b` are not eigenvalues of `A`. -/
def IsBand (A : 𝕄) (a b : ℝ) : Prop :=
  A.IsHermitian ∧ (spectrum ℂ A ∩ interval a b).Nonempty ∧
    (spectrum ℂ A \ interval a b).Nonempty ∧ (a : ℂ) ∉ spectrum ℂ A ∧ (b : ℂ) ∉ spectrum ℂ A

/-- **Definition 2.5(i).** The *spectral gap* of the band `{λ : a < λ < b}` of a Hermitian `A` is
the least distance `|λ - μ|` from an eigenvalue `λ` in the band to an eigenvalue `μ` outside it. -/
def spectralGap (A : 𝕄) (a b : ℝ) : ℝ :=
  sInf {r : ℝ | ∃ x y : ℝ, (x : ℂ) ∈ spectrum ℂ A ∩ interval a b ∧
    (y : ℂ) ∈ spectrum ℂ A \ interval a b ∧ r = |x - y|}

/-- **Definition 2.5(ii).** If `A` is unitary, a *band* of `A` is a nonempty proper subset of its
eigenvalues of the form `{e^{-iθ} : a < θ < b}` with `a < b < a + 2π`, where `e^{-ia}` and
`e^{-ib}` are not eigenvalues of `A`. -/
def IsArcBand (A : 𝕄) (a b : ℝ) : Prop :=
  IsUnitary A ∧ a < b ∧ b < a + 2 * π ∧ (spectrum ℂ A ∩ arc a b).Nonempty ∧
    (spectrum ℂ A \ arc a b).Nonempty ∧ Complex.exp (-I * (a : ℂ)) ∉ spectrum ℂ A ∧
    Complex.exp (-I * (b : ℂ)) ∉ spectrum ℂ A

/-- The distance along the circle between `e^{-iθ}` and `e^{-iφ}`: `min_{k ∈ ℤ} |θ - φ + 2πk|`. -/
def circleDistance (θ φ : ℝ) : ℝ := ⨅ k : ℤ, |θ - φ + 2 * π * k|

/-- **Definition 2.5(ii).** The *eigenphase gap* of the band `{e^{-iθ} : a < θ < b}` of a unitary
`A` is the least distance along the circle from an eigenvalue `e^{-iθ}` in the band to an
eigenvalue `e^{-iφ}` outside it. -/
def eigenphaseGap (A : 𝕄) (a b : ℝ) : ℝ :=
  sInf {r : ℝ | ∃ θ φ : ℝ, Complex.exp (-I * (θ : ℂ)) ∈ spectrum ℂ A ∩ arc a b ∧
    Complex.exp (-I * (φ : ℂ)) ∈ spectrum ℂ A \ arc a b ∧ r = circleDistance θ φ}

/-- **Definition 2.5(iii).** The *spectral projector* of `A` for the eigenvalues in a set `S`
projects orthogonally onto the span of the eigenvectors of `A` with eigenvalues in `S`. The
spectral projector of a band is `spectralProjector A (interval a b)` for Hermitian `A` and
`spectralProjector A (arc a b)` for unitary `A`. In Lean, the span of the eigenvectors is the
supremum `⨆ z ∈ S` of the eigenspaces of `A` for `z ∈ S`, `starProjection` is the orthogonal
projector onto a subspace, and `toEuclideanCLM` identifies matrices with operators on `ℂ^d`. -/
def spectralProjector (A : 𝕄) (S : Set ℂ) : 𝕄 :=
  (Matrix.toEuclideanCLM (n := Fin d) (𝕜 := ℂ)).symm
    (⨆ z ∈ S, Module.End.eigenspace
      ((Matrix.toEuclideanCLM (n := Fin d) (𝕜 := ℂ)) A).toLinearMap z).starProjection

/-- **Definition 2.5(iv).** A *band* of a Hermitian family `A(s)` with `s ∈ [0,1]` is a band of
each `A(s)` with endpoints `a(s)` and `b(s)` continuous in `s`. Its spectral projectors at `s = 0`
and `s = 1` are its *endpoint projectors*. -/
def IsBandFamily (A : ℝ → 𝕄) (a b : ℝ → ℝ) : Prop :=
  ContinuousOn a (Icc 0 1) ∧ ContinuousOn b (Icc 0 1) ∧
    ∀ s ∈ Icc (0 : ℝ) 1, IsBand (A s) (a s) (b s)

/-- **Definition 2.5(iv).** A *band* of a unitary family `A(s)` with `s ∈ [0,1]` is a band of each
`A(s)` with endpoints `a(s)` and `b(s)` continuous in `s`. Its spectral projectors at `s = 0` and
`s = 1` are its *endpoint projectors*. -/
def IsArcBandFamily (A : ℝ → 𝕄) (a b : ℝ → ℝ) : Prop :=
  ContinuousOn a (Icc 0 1) ∧ ContinuousOn b (Icc 0 1) ∧
    ∀ s ∈ Icc (0 : ℝ) 1, IsArcBand (A s) (a s) (b s)

/-- **Definition 2.5(iv).** The number of eigenvalues of `A` in a set `S`, counted with
multiplicity. A band of a family is a *band of `m` eigenvalues* if this number is `m` for every
`A(s)`. -/
def eigenvalueCount (A : 𝕄) (S : Set ℂ) : ℕ :=
  open Classical in (A.charpoly.roots.filter (· ∈ S)).card

/-- Remark 3.8. For the band `{λ : a < λ < b}` of a Hermitian `A`, with eigenvalues `S` in the band,
the real numbers within `ε` of the interval `[min S, max S]`. -/
def nearBand (A : 𝕄) (a b ε : ℝ) : Set ℂ :=
  let S := {x : ℝ | (x : ℂ) ∈ spectrum ℂ A ∩ interval a b}
  (fun x : ℝ ↦ (x : ℂ)) '' Icc (sInf S - ε) (sSup S + ε)

/-- Example 5.1. The least eigenvalue of a Hermitian `A`. -/
def leastEigenvalue (A : 𝕄) : ℝ :=
  sInf {x : ℝ | (x : ℂ) ∈ spectrum ℂ A}

/-- Example 5.1. The *spectral gap of the least eigenvalue* of a Hermitian `A`: the least distance
from its least eigenvalue to another eigenvalue. -/
def leastEigenvalueGap (A : 𝕄) : ℝ :=
  sInf {r : ℝ | ∃ y : ℝ, (y : ℂ) ∈ spectrum ℂ A ∧ leastEigenvalue A < y ∧ r = y - leastEigenvalue A}

/-! ## Section 3: truncation, checkpoints, and midpoint products -/

/-- **Definition 3.1.** For a function `F : ℝ → ℝ` and a matrix `A`, `A^{(F)}` is the matrix with
entries `F(Re A_pq) + i F(Im A_pq)`. For a matrix-valued function `H`, `H^{(F)}(s)` is
`entrywise F (H s)`. -/
def entrywise (F : ℝ → ℝ) (A : 𝕄) : 𝕄 :=
  Matrix.of fun p q ↦ ⟨F (A p q).re, F (A p q).im⟩

/-- Example 3.2. *Bit truncation* is `[x]_k = sgn(x) 2^{-k} ⌊2^k |x|⌋`. The truncation `H^{(k)}`
of `H` is `fun s ↦ entrywise (bitTruncation k) (H s)`. -/
def bitTruncation (k : ℕ) (x : ℝ) : ℝ :=
  Real.sign x * ((2 : ℝ) ^ k)⁻¹ * (⌊(2 : ℝ) ^ k * |x|⌋ : ℝ)

/-- Example 3.2. `σ_k` is the largest number of entries that truncation at the `k`-th binary place
changes in a row of `H(s)`, over all rows and all `s ∈ [0,1]`. -/
def sparsity (k : ℕ) (H : ℝ → 𝕄) : ℕ :=
  ⨆ s : Icc (0 : ℝ) 1, ⨆ p : Fin d,
    (Finset.univ.filter fun q ↦ entrywise (bitTruncation k) (H s) p q ≠ H s p q).card

/-- Section 3. *Checkpoints* `0 = s_0 ≤ ⋯ ≤ s_N = 1`. -/
def IsCheckpoints (N : ℕ) (s : ℕ → ℝ) : Prop :=
  (∀ j < N, s j ≤ s (j + 1)) ∧ s 0 = 0 ∧ s N = 1

/-- **Definition 3.3.** Checkpoints `0 = s_0 ≤ ⋯ ≤ s_N = 1` have *midpoint error at most `ε`* for
`H` if `‖H(s) - H(s_{j+1/2})‖ ≤ ε` for every `j` and every `s` with `s_j < s < s_{j+1}`, where
`s_{j+1/2} = (s_j + s_{j+1})/2`. -/
def HasMidpointError (H : ℝ → 𝕄) (N : ℕ) (s : ℕ → ℝ) (ε : ℝ) : Prop :=
  ∀ j < N, ∀ x ∈ Ioo (s j) (s (j + 1)), ‖H x - H ((s j + s (j + 1)) / 2)‖ ≤ ε

/-- **Definition 3.5.** The *midpoint product* of a Hermitian family `A` over time `T` on
checkpoints `s_0, …, s_N` is
`e^{-iT(s_N - s_{N-1})A(s_{N-1/2})} ⋯ e^{-iT(s_1 - s_0)A(s_{1/2})}`,
where `s_{j+1/2} = (s_j + s_{j+1})/2`. -/
def midpointProduct (A : ℝ → 𝕄) (T : ℝ) (N : ℕ) (s : ℕ → ℝ) : 𝕄 :=
  ((List.range N).reverse.map fun j ↦
    exp ((-I * (T * (s (j + 1) - s j) : ℝ)) • A ((s j + s (j + 1)) / 2))).prod

/-! ## Section 4: the width hypothesis, the multiplier, and the constants -/

/-- Section 4. A matrix has *eigenvalue differences of modulus at most a width `w`*. The paper
applies this to Hermitian matrices, whose eigenvalues are real. -/
def HasWidth (A : 𝕄) (w : ℝ) : Prop :=
  ∀ x ∈ spectrum ℝ A, ∀ y ∈ spectrum ℝ A, |x - y| ≤ w

/-- Theorem 4.2. The samples `H(j/T)` for `0 ≤ j ≤ T` have eigenvalue differences of modulus at
most `w`: the *width hypothesis* when `w < 2π`. -/
def HasSampleWidth (H : ℝ → 𝕄) (T : ℕ) (w : ℝ) : Prop :=
  ∀ j : ℕ, j ≤ T → HasWidth (H (j / T)) w

/-- Theorem 4.2. `H(s)` for `s ∈ [0,1]` is differentiable, with one-sided derivatives at `s = 0`
and `s = 1`, and `‖H'(s₁) - H'(s₂)‖ ≤ L |s₁ - s₂|` for `s₁, s₂ ∈ [0,1]`. -/
def HasLipschitzDerivative (H : ℝ → 𝕄) (L : ℝ) : Prop :=
  DifferentiableOn ℝ H (Icc 0 1) ∧
    ∀ s₁ ∈ Icc (0 : ℝ) 1, ∀ s₂ ∈ Icc (0 : ℝ) 1, ‖∂H s₁ - ∂H s₂‖ ≤ L * |s₁ - s₂|

/-- **Definition 4.1.** `𝒩(x) = (1 - (x/2) cot(x/2)) / x²` for `x ≠ 0`, and `𝒩(0) = 1/12`. This is
the multiplier at real `x`; `𝒩ℂ` is the same formula at complex `x`. -/
def 𝒩 (x : ℝ) : ℝ :=
  if x = 0 then 1 / 12 else (1 - (x / 2) * Real.cot (x / 2)) / x ^ 2

/-- **Definition 4.1.** For complex `x ∉ 2πℤ ∖ {0}`, `𝒩(x) = (1 - (x/2) cot(x/2)) / x²` for
`x ≠ 0`, and `𝒩(0) = 1/12`. It agrees with `𝒩` at real `x` (`ofReal_𝒩`). -/
def 𝒩ℂ (x : ℂ) : ℂ :=
  if x = 0 then 1 / 12 else (1 - (x / 2) * Complex.cot (x / 2)) / x ^ 2

/-- **Definition 4.1.** For a Hermitian `Ω` with eigenvalue differences of modulus less than `2π`
and a matrix `E`, `𝒩([Ω,·])E` is the matrix with `ψ_p† (𝒩([Ω,·])E) ψ_q = 𝒩(λ_p - λ_q) ψ_p† E ψ_q`
in an orthonormal eigenbasis `ψ_p` of `Ω` with eigenvalues `λ_p`. The columns of the unitary `Ψ`
below are the `ψ_p`. For any other `Ω` the value is `0`. -/
def 𝒩ad (Ω E : 𝕄) : 𝕄 :=
  if hΩ : Ω.IsHermitian then
    if ∀ p q, |hΩ.eigenvalues p - hΩ.eigenvalues q| < 2 * π then
      let Ψ : 𝕄 := hΩ.eigenvectorUnitary
      Ψ * Matrix.of (fun p q ↦
        (𝒩 (hΩ.eigenvalues p - hΩ.eigenvalues q) : ℂ) * (Ψ† * E * Ψ) p q) * Ψ†
    else 0
  else 0

/-- Theorem 4.2. The jump
`Δ_j = (1/T) (𝒩([H(j/T),·])H'(j/T) - 𝒩([H((j-1)/T),·])H'((j-1)/T))`. -/
def Δ (H : ℝ → 𝕄) (T j : ℕ) : 𝕄 :=
  (1 / T : ℝ) • (𝒩ad (H ((j : ℝ) / T)) (∂H ((j : ℝ) / T)) -
    𝒩ad (H (((j : ℝ) - 1) / T)) (∂H (((j : ℝ) - 1) / T)))

/-- Appendix B. `c₀ = 1/(2w sin(w/2)) - 1/w²` for `0 < w < 2π`, and `c₀ = 1/24` at width `0`. -/
def c₀ (w : ℝ) : ℝ :=
  if w = 0 then 1 / 24 else 1 / (2 * w * Real.sin (w / 2)) - 1 / w ^ 2

/-- Appendix B. `κ = (w/2)/sin(w/2)` for `0 < w < 2π`, and `κ = 1` at width `0`. -/
def κ (w : ℝ) : ℝ :=
  if w = 0 then 1 else (w / 2) / Real.sin (w / 2)

/-- Appendix B. `c₁ = c₀/4 + 1/64`. -/
def c₁ (w : ℝ) : ℝ := c₀ w / 4 + 1 / 64

/-- Appendix B.
`c₂ = (1/24 + 𝒩(w))/cos²(w/4) + c₁κ² + 2𝒩'(w)κ + (𝒩(w) - 𝒩(0))κ²`. -/
def c₂ (w : ℝ) : ℝ :=
  (1 / 24 + 𝒩 w) / Real.cos (w / 4) ^ 2 + c₁ w * κ w ^ 2 + 2 * deriv 𝒩 w * κ w +
    (𝒩 w - 𝒩 0) * κ w ^ 2

/-- Appendix B. For `H`, `L`, and `w` as in Theorem 4.2,
`ℰ_w(H) = c₀ (‖H'(0)‖ + ‖H'(1)‖) + (1/24 + 𝒩(w)) L + (c₁ + 2𝒩'(w)) ‖H'‖∞²`. -/
def ℰ (w L : ℝ) (H : ℝ → 𝕄) : ℝ :=
  c₀ w * (‖∂H 0‖ + ‖∂H 1‖) + (1 / 24 + 𝒩 w) * L + (c₁ w + 2 * deriv 𝒩 w) * ‖∂H‖∞ ^ 2

/-- Appendix B. For `W` and `w` as in Theorem 4.6,
`ℰ̃_w(W) = c₀κ (‖W'(0)‖ + ‖W'(1)‖) + (1/24 + 𝒩(w)) κ ‖W''‖∞ + c₂ ‖W'‖∞²`. -/
def ℰtilde (w : ℝ) (W : ℝ → 𝕄) : ℝ :=
  c₀ w * κ w * (‖∂W 0‖ + ‖∂W 1‖) + (1 / 24 + 𝒩 w) * κ w * ‖∂∂W‖∞ + c₂ w * ‖∂W‖∞ ^ 2

/-- Theorem 4.7. `H` is the Hermitian logarithm of the unitary family `W` with its branch cut at
`α`: for every `s ∈ [0,1]`, `H(s)` is Hermitian, `e^{-iH(s)} = W(s)`, and the spectrum of `H(s)`
lies in `(α(s), α(s) + 2π)`. -/
def IsLogarithm (W : ℝ → 𝕄) (α : ℝ → ℝ) (H : ℝ → 𝕄) : Prop :=
  IsTimeDepHamiltonian H ∧ (∀ s ∈ Icc (0 : ℝ) 1, exp (-I • H s) = W s) ∧
    ∀ s ∈ Icc (0 : ℝ) 1, ∀ x ∈ spectrum ℝ (H s), x ∈ Ioo (α s) (α s + 2 * π)

end RoundedClocks
