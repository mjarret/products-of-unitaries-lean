module

public import RoundedClocks.Examples.PrecessingSpinMatrix
public import RoundedClocks.Preliminaries

/-! # Example 5.2: the two opening displays

In the frame that rotates with the field, the evolution and the product with its end phases are
`U(T) = e^{-iθZ/2} e^{-i(ωTX-θZ)/2}` (`evolution_end_eq`) and `V(T) = e^{-iθZ/2} S^T` with
`S = e^{-iωX/4} e^{iθZ/(2T)} e^{-iωX/4}` (`roundedEvolution_end_eq`). The first holds as
`H(t/T) = e^{-iθtZ/(2T)} (ω/2) X e^{iθtZ/(2T)}`, and the second follows from (2.5), as the factors
are `e^{-iθjZ/(2T)} e^{-iωX/2} e^{iθjZ/(2T)}`.
-/

@[expose] public section

noncomputable section
namespace RoundedClocks.PrecessingSpin

/-! ## The first opening display: `U(T) = e^{-iθZ/2} e^{-i(ωTX-θZ)/2}` -/

section Frame

open scoped Matrix.Norms.L2Operator
open NormedSpace (exp)
open Complex (I)

/-- Mathlib's exponential lemmas use the matrices as a normed algebra over `ℚ`. -/
local instance : NormedAlgebra ℚ (Matrix (Fin 2) (Fin 2) ℂ) :=
  .restrictScalars ℚ ℂ _

/-- `(e^{uA} e^{u(B-A)})' = e^{uA} B e^{u(B-A)}`. -/
theorem rotating_frame_derivative
    (A B : Matrix (Fin 2) (Fin 2) ℂ) (t : ℝ) :
    HasDerivAt (fun u : ℝ ↦ exp (u • A) * exp (u • (B - A)))
      (exp (t • A) * B * exp (t • (B - A))) t := by
  have hA := hasDerivAt_exp_smul_const (𝕂 := ℝ) A t
  have hB := hasDerivAt_exp_smul_const' (𝕂 := ℝ) (B - A) t
  convert hA.mul hB using 1
  rw [← mul_assoc (exp (t • A)), mul_sub, sub_mul, ← add_sub_assoc, add_sub_cancel_left]

/-- `e^{-tA} e^{tA} = 1`. -/
theorem rotating_frame_cancel (A : Matrix (Fin 2) (Fin 2) ℂ) (t : ℝ) :
    exp (-(t • A)) * exp (t • A) = 1 := by
  rw [← NormedSpace.exp_add_of_commute (Commute.neg_left (Commute.refl (t • A))),
    neg_add_cancel, NormedSpace.exp_zero]

/-- `e^{e^A B e^{-A}} = e^A e^B e^{-A}`. -/
theorem rotating_frame_sample (A B : Matrix (Fin 2) (Fin 2) ℂ) :
    exp (exp A * B * exp (-A)) = exp A * exp B * exp (-A) := by
  rw [Matrix.exp_neg]
  exact Matrix.exp_conj (exp A) B (NormedSpace.isUnit_exp A)

end Frame

section FrameEvolution

open scoped Matrix.Norms.L2Operator
open NormedSpace (exp)
open Complex (I)
open Set Matrix

/-- Mathlib's exponential lemmas use the matrices as a normed algebra over `ℚ`. -/
local instance : NormedAlgebra ℚ (Matrix (Fin 2) (Fin 2) ℂ) :=
  .restrictScalars ℚ ℂ _

/-- In the frame that rotates with the field: for Hermitian `A` and `B`, `e^{-itA} e^{-it(B-A)}` is
the evolution generated by `e^{-itA} B e^{itA}`. -/
theorem frame_generates (A B : Matrix (Fin 2) (Fin 2) ℂ)
    (hA : A.IsHermitian) (hB : B.IsHermitian) (T : ℝ) :
    Generates
      (fun t : ℝ ↦ exp (t • (-I • A)) * B * exp (-(t • (-I • A))))
      (fun t : ℝ ↦ exp (t • (-I • A)) * exp (t • (-I • (B - A)))) 0 T := by
  have hd (t : ℝ) := rotating_frame_derivative (-I • A) (-I • B) t
  simp only [← smul_sub] at hd
  refine ⟨?_, ?_, ?_, ∅, Set.countable_empty, ?_⟩
  · exact (continuous_iff_continuousAt.mpr fun t ↦ (hd t).continuousAt).continuousOn
  · simp only [zero_smul, NormedSpace.exp_zero, one_mul]
  · intro t _
    have hU : IsUnitary (exp (t • (-I • A))) := by
      simpa only [Complex.coe_smul] using exp_neg_I_smul_isUnitary hA t
    have hV : IsUnitary (exp (t • (-I • (B - A)))) := by
      simpa only [Complex.coe_smul] using exp_neg_I_smul_isUnitary (hB.sub hA) t
    exact mul_mem hU hV
  · intro t _ _
    have hcancel := rotating_frame_cancel (-I • A) t
    have heq : -I • ((exp (t • (-I • A)) * B * exp (-(t • (-I • A)))) *
        (exp (t • (-I • A)) * exp (t • (-I • (B - A))))) =
        exp (t • (-I • A)) * (-I • B) * exp (t • (-I • (B - A))) := by
      rw [mul_assoc, mul_assoc, ← mul_assoc (exp (-(t • (-I • A)))), hcancel,
        one_mul, mul_smul_comm, smul_mul_assoc, mul_assoc]
    rw [heq]
    exact (hd t).hasDerivWithinAt

/-- The evolution generated by `e^{-itA} B e^{itA}` for `t ∈ [0,T]` ends at `e^{-iTA} e^{-iT(B-A)}`,
as a Hamiltonian generates only one evolution. -/
theorem frame_evolution (dieudonne_10_5_4 : Dieudonne_10_5_4)
    (dieudonne_10_6_3 : Dieudonne_10_6_3)
    (A B : Matrix (Fin 2) (Fin 2) ℂ) (hA : A.IsHermitian) (hB : B.IsHermitian)
    {T : ℝ} (hT : 0 ≤ T) :
    evolutionOf (fun t : ℝ ↦ exp (t • (-I • A)) * B * exp (-(t • (-I • A)))) T T =
      exp (T • (-I • A)) * exp (T • (-I • (B - A))) := by
  let G := fun t : ℝ ↦ exp (t • (-I • A)) * B * exp (-(t • (-I • A)))
  have hGc : Continuous G := by unfold G; fun_prop
  have hreg : IsRegulated G 0 T := ContinuousOn.isRegulated hGc.continuousOn
  have hAs : star A = A := hA
  have hBs : star B = B := hB
  have hHerm : IsHermitianFamily G 0 T := by
    intro t _
    have hstar : star (t • (-I • A)) = -(t • (-I • A)) := by
      rw [star_smul, star_smul, star_neg, Complex.star_def, Complex.conj_I,
        hAs, star_trivial, neg_neg, neg_smul, smul_neg, neg_neg]
    change star (G t) = G t
    dsimp only [G]
    rw [Matrix.star_mul, Matrix.star_mul, NormedSpace.star_exp, NormedSpace.star_exp,
      star_neg, hstar, neg_neg, hBs, mul_assoc]
  have hcanonical := generates_evolutionOf dieudonne_10_5_4 dieudonne_10_6_3 hT hreg hHerm
  exact generates_unique dieudonne_10_5_4 hreg hcanonical
    (frame_generates A B hA hB T) ⟨hT, le_rfl⟩

end FrameEvolution

section EvolutionEnd

open scoped Matrix.Norms.L2Operator
open NormedSpace (exp)
open Complex (I)

/-- `t(-i(aA)) = (-(at) i) A`. -/
theorem frame_scalar (a t : ℝ) (A : Matrix (Fin 2) (Fin 2) ℂ) :
    t • (-I • (a • A)) = (-(a * t : ℂ) * I) • A := by
  ext i j
  simp only [Matrix.smul_apply, Complex.real_smul, smul_eq_mul]
  ring

/-- The first opening display of Example 5.2: `U(T) = e^{-iθZ/2} e^{-i(ωTX-θZ)/2}`, as
`H(t/T) = e^{-iθtZ/(2T)} (ω/2) X e^{iθtZ/(2T)}`. -/
theorem evolution_end_eq (dieudonne_10_5_4 : Dieudonne_10_5_4)
    (dieudonne_10_6_3 : Dieudonne_10_6_3)
    (ω θ : ℝ) {T : ℝ} (hT : 0 < T) :
    let H := fun s : ℝ ↦ (ω / 2 : ℝ) •
      (exp (-(θ * s / 2 * I) • Z) * X * exp ((θ * s / 2 * I) • Z))
    evolution H T T = exp (-(θ / 2 * I) • Z) *
      exp ((-I / 2) • ((ω * T) • X - θ • Z)) := by
  dsimp only
  have hZ : ((θ / (2 * T)) • Z).IsHermitian :=
    (show IsSelfAdjoint (θ / (2 * T)) from rfl).smul
      Z_isHermitian.isSelfAdjoint
  have hX : ((ω / 2) • X).IsHermitian :=
    (show IsSelfAdjoint (ω / 2) from rfl).smul X_isHermitian.isSelfAdjoint
  have h := frame_evolution dieudonne_10_5_4 dieudonne_10_6_3
    ((θ / (2 * T)) • Z) ((ω / 2) • X) hZ hX hT.le
  have hfamily :
      (fun t : ℝ ↦ (ω / 2 : ℝ) •
        (exp (-(θ * ((t / T : ℝ) : ℂ) / 2 * I) • Z) * X *
          exp ((θ * ((t / T : ℝ) : ℂ) / 2 * I) • Z))) =
      (fun t : ℝ ↦ exp (t • (-I • ((θ / (2 * T)) • Z))) *
        ((ω / 2) • X) * exp (-(t • (-I • ((θ / (2 * T)) • Z))))) := by
    funext t
    rw [frame_scalar, ← smul_mul_assoc, ← mul_smul_comm]
    have hc : (-(((θ / (2 * T) : ℝ) : ℂ) * t) * I) = -(θ * ((t / T : ℝ) : ℂ) / 2 * I) := by
      push_cast
      ring
    rw [hc, neg_smul, neg_neg]
  change evolutionOf _ T T = _
  rw [hfamily, h, frame_scalar]
  have hTc : (T : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hT.ne'
  congr 1
  · congr 1
    congr 1
    push_cast
    field_simp [hTc]
  · congr 1
    ext i j
    simp only [smul_sub, Matrix.sub_apply, Matrix.smul_apply, Complex.real_smul,
      smul_eq_mul]
    push_cast
    field_simp [hTc]
    ring

end EvolutionEnd

/-! ## The second opening display: `V(T) = e^{-iθZ/2} S^T` -/

section Factors

open scoped Matrix.Norms.L2Operator
open NormedSpace (exp)
open Complex (I)

/-- The factors of the product: `e^{-iH(s)} = e^{-iθsZ/2} e^{-iωX/2} e^{iθsZ/2}`. -/
theorem sampled_factor (ω θ s : ℝ) :
    exp (-I • ((ω / 2 : ℝ) •
      (exp (-(θ * s / 2 * I) • Z) * X * exp ((θ * s / 2 * I) • Z)))) =
      exp (-(θ * s / 2 * I) • Z) * exp ((-I * (ω / 2 : ℝ)) • X) *
        exp ((θ * s / 2 * I) • Z) := by
  have hneg : -(-(θ * s / 2 * I) • Z) = (θ * s / 2 * I) • Z := by
    rw [neg_smul, neg_neg]
  have hscalar : -I • ((ω / 2 : ℝ) • X) = (-I * (ω / 2 : ℝ)) • X := by
    ext i j
    simp only [Matrix.smul_apply, Complex.real_smul, smul_eq_mul]
    ring
  have hmove (R V : Matrix (Fin 2) (Fin 2) ℂ) :
      -I • ((ω / 2 : ℝ) • (R * X * V)) = R * ((-I * (ω / 2 : ℝ)) • X) * V := by
    rw [← hscalar, mul_smul_comm, smul_mul_assoc, mul_smul_comm, smul_mul_assoc]
  rw [hmove, ← hneg]
  exact rotating_frame_sample _ _

/-- Equation (2.5) for the precessing spin: `V(T) = e^{-iH(1)/2} W_T e^{iH(0)/2}`. -/
theorem rounded_endpoint_phases (dieudonne_10_5_4 : Dieudonne_10_5_4) (ω θ : ℝ) {T : ℕ}
    (hT : 1 ≤ T) :
    let H := fun s : ℝ ↦ (ω / 2 : ℝ) •
      (exp (-(θ * s / 2 * I) • Z) * X * exp ((θ * s / 2 * I) • Z))
    roundedEvolution H T T =
      exp (-(I / 2) • H 1) * stepProduct H T * exp ((I / 2) • H 0) := by
  dsimp only
  apply roundedEvolution_end dieudonne_10_5_4 _ hT
  intro s _
  have h : exp ((θ * s / 2 * I) • Z) = star (exp (-(θ * s / 2 * I) • Z)) := by
    simp [NormedSpace.star_exp, star_smul, show star Z = Z from Z_isHermitian]
  change IsHermitian ((ω / 2 : ℝ) • _)
  rw [h]
  exact (IsSelfAdjoint.all (ω / 2 : ℝ)).smul (X_isHermitian.isSelfAdjoint.conjugate _)

end Factors

section Telescope

open scoped Matrix.Norms.L2Operator
open NormedSpace (exp)

/-- Mathlib's exponential lemmas use the matrices as a normed algebra over `ℚ`. -/
local instance : NormedAlgebra ℚ (Matrix (Fin 2) (Fin 2) ℂ) :=
  .restrictScalars ℚ ℂ _

/-- `e^{sA} e^{tA} = e^{(s+t)A}`. -/
theorem frame_add (A : Matrix (Fin 2) (Fin 2) ℂ) (s t : ℝ) :
    exp (s • A) * exp (t • A) = exp ((s + t) • A) := by
  rw [add_smul, NormedSpace.exp_add_of_commute
    (((Commute.refl A).smul_left s).smul_right t)]

/-- The product of the factors telescopes:
`(e^{(n-1)A} B e^{-(n-1)A}) ⋯ (e^{A} B e^{-A}) B = e^{nA} (e^{-A} B)^n`. -/
theorem sampled_product (A B : Matrix (Fin 2) (Fin 2) ℂ) (n : ℕ) :
    ((List.range n).reverse.map fun j : ℕ ↦
      exp ((j : ℝ) • A) * B * exp (-((j : ℝ) • A))).prod =
      exp ((n : ℝ) • A) * (exp (-A) * B) ^ n := by
  induction n with
  | zero => simp only [List.range_zero, List.reverse_nil, List.map_nil, List.prod_nil,
      Nat.cast_zero, zero_smul, NormedSpace.exp_zero, pow_zero, mul_one]
  | succ n ih =>
    have hcancel := rotating_frame_cancel A (n : ℝ)
    have hjoin : exp (((n + 1 : ℕ) : ℝ) • A) * exp (-A) = exp ((n : ℝ) • A) := by
      rw [show -A = (-1 : ℝ) • A by simp only [neg_one_smul], frame_add]
      congr 1
      push_cast
      ring_nf
    rw [List.range_succ, List.reverse_append]
    simp only [List.reverse_cons, List.reverse_nil, List.nil_append, List.map_append,
      List.map_cons, List.map_nil, List.prod_append, List.prod_cons, List.prod_nil, mul_one]
    rw [ih, pow_succ']
    simp only [mul_assoc]
    rw [← mul_assoc (exp (-((n : ℝ) • A))), hcancel, one_mul,
      ← mul_assoc (exp (((n + 1 : ℕ) : ℝ) • A)), hjoin]

/-- `e^B (e^A e^{2B})^n e^{-B} = (e^B e^A e^B)^n`. -/
theorem symmetrized_power (A B : Matrix (Fin 2) (Fin 2) ℂ) (n : ℕ) :
    exp B * (exp A * exp (B + B)) ^ n * exp (-B) =
      (exp B * exp A * exp B) ^ n := by
  have hleft : exp (-B) * exp B = 1 := by
    simpa only [one_smul] using rotating_frame_cancel B 1
  have hright : exp B * exp (-B) = 1 := by
    simpa only [one_smul, neg_neg] using rotating_frame_cancel (-B) 1
  let u : (Matrix (Fin 2) (Fin 2) ℂ)ˣ := ⟨exp B, exp (-B), hright, hleft⟩
  have hconj : exp B * (exp A * exp (B + B)) * exp (-B) =
      exp B * exp A * exp B := by
    rw [NormedSpace.exp_add_of_commute (Commute.refl B)]
    simp only [mul_assoc]
    rw [hright, mul_one]
  have hpower := u.conj_pow (exp A * exp (B + B)) n
  change (exp B * (exp A * exp (B + B)) * exp (-B)) ^ n =
    exp B * (exp A * exp (B + B)) ^ n * exp (-B) at hpower
  rw [hconj] at hpower
  exact hpower.symm

end Telescope

section RoundedEnd

open scoped Matrix.Norms.L2Operator
open NormedSpace (exp)
open Complex (I)

/-- The second opening display of Example 5.2: `V(T) = e^{-iθZ/2} S^T` with
`S = e^{-iωX/4} e^{iθZ/(2T)} e^{-iωX/4}`. It follows from (2.5), as the factors are
`e^{-iθjZ/(2T)} e^{-iωX/2} e^{iθjZ/(2T)}`. -/
theorem roundedEvolution_end_eq (dieudonne_10_5_4 : Dieudonne_10_5_4) (ω θ : ℝ) {T : ℕ}
    (hT : 1 ≤ T) :
    let H := fun s : ℝ ↦ (ω / 2 : ℝ) •
      (exp (-(θ * s / 2 * I) • Z) * X * exp ((θ * s / 2 * I) • Z))
    let S := exp (-(ω / 4 * I) • X) * exp ((θ / (2 * T) * I) • Z) *
      exp (-(ω / 4 * I) • X)
    roundedEvolution H T T = exp (-(θ / 2 * I) • Z) * S ^ T := by
  let A : Matrix (Fin 2) (Fin 2) ℂ := -(θ / (2 * T) * I) • Z
  let B : Matrix (Fin 2) (Fin 2) ℂ := -(ω / 4 * I) • X
  -- With `A = -iθZ/(2T)` and `B = -iωX/4`, the factors are `e^{jA} e^{2B} e^{-jA}`.
  have hTc : (T : ℂ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hT)
  have hsample (j : ℕ) :
      -(θ * ((j : ℝ) / T : ℝ) / 2 * I) • Z = (j : ℝ) • A := by
    dsimp only [A]
    ext i k
    simp only [Matrix.smul_apply, Complex.real_smul, smul_eq_mul]
    push_cast
    ring
  have hwhole : (T : ℝ) • A = -(θ / 2 * I) • Z := by
    dsimp only [A]
    ext i k
    simp only [Matrix.smul_apply, Complex.real_smul, smul_eq_mul]
    push_cast
    field_simp [hTc]
  have hdouble : (-I * (ω / 2 : ℝ)) • X = B + B := by
    dsimp only [B]
    ext i k
    simp only [Matrix.smul_apply, Matrix.add_apply, smul_eq_mul]
    push_cast
    ring
  -- So the product telescopes: `W_T = e^{TA} (e^{-A} e^{2B})^T`.
  have hprod : stepProduct (fun s : ℝ ↦ (ω / 2 : ℝ) •
      (exp (-(θ * s / 2 * I) • Z) * X * exp ((θ * s / 2 * I) • Z))) T =
      exp ((T : ℝ) • A) * (exp (-A) * exp (B + B)) ^ T := by
    unfold stepProduct sampleProduct orderedProduct
    simp_rw [sampled_factor, hdouble]
    have hpos (j : ℕ) :
        (θ * ((j : ℝ) / T : ℝ) / 2 * I) • Z = -((j : ℝ) • A) := by
      rw [← hsample, neg_smul, neg_neg]
    simp_rw [hsample, hpos]
    exact sampled_product A (exp (B + B)) T
  -- The end phases: `e^{-iH(1)/2} = e^{TA} e^{B} e^{-TA}` and `e^{iH(0)/2} = e^{-B}`.
  have hphase :
      exp (-(I / 2) • ((ω / 2 : ℝ) •
        (exp (-(θ * 1 / 2 * I) • Z) * X * exp ((θ * 1 / 2 * I) • Z)))) =
      exp ((T : ℝ) • A) * exp B * exp (-((T : ℝ) • A)) := by
    rw [hwhole]
    have hscalar : -(I / 2) • ((ω / 2 : ℝ) • X) = B := by
      ext i k
      simp only [B, Matrix.smul_apply, Complex.real_smul, smul_eq_mul]
      push_cast
      ring
    have hgen : -(I / 2) • ((ω / 2 : ℝ) •
        (exp (-(θ * 1 / 2 * I) • Z) * X * exp ((θ * 1 / 2 * I) • Z))) =
        exp (-(θ / 2 * I) • Z) * B * exp (-(-(θ / 2 * I) • Z)) := by
      rw [← hscalar]
      simp only [mul_one]
      rw [show -(-(θ / 2 * I) • Z) = (θ / 2 * I) • Z by
        rw [neg_smul, neg_neg]]
      rw [mul_smul_comm, smul_mul_assoc, mul_smul_comm, smul_mul_assoc]
    rw [hgen, rotating_frame_sample]
  have hzero :
      exp ((I / 2) • ((ω / 2 : ℝ) •
        (exp (-(θ * 0 / 2 * I) • Z) * X * exp ((θ * 0 / 2 * I) • Z)))) =
      exp (-B) := by
    congr 1
    simp only [mul_zero, zero_div, zero_mul, neg_zero]
    simp only [zero_smul, NormedSpace.exp_zero, one_mul, mul_one]
    rw [show -B = (ω / 4 * I) • X by simp only [B, neg_smul, neg_neg]]
    ext i k
    simp only [Matrix.smul_apply, Complex.real_smul, smul_eq_mul]
    push_cast
    ring
  -- By (2.5), `V(T) = e^{TA} e^{B} (e^{-A} e^{2B})^T e^{-B} = e^{TA} (e^{B} e^{-A} e^{B})^T`, and
  -- `e^{TA} = e^{-iθZ/2}` and `e^{B} e^{-A} e^{B} = S`.
  dsimp only
  rw [rounded_endpoint_phases dieudonne_10_5_4 ω θ hT, hprod]
  simp only [Complex.ofReal_one, Complex.ofReal_zero]
  rw [hphase, hzero]
  have hcancel := rotating_frame_cancel A (T : ℝ)
  simp only [mul_assoc]
  rw [← mul_assoc (exp (-((T : ℝ) • A))), hcancel, one_mul]
  rw [← mul_assoc (exp B), symmetrized_power, hwhole]
  simp only [A, B, neg_smul, neg_neg, mul_assoc]

end RoundedEnd

end RoundedClocks.PrecessingSpin
