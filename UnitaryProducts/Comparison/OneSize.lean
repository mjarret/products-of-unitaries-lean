/-- **The evolution of a path over time $T$** (§2, unnumbered). The evolution of a path $H$ over
time $T$ is the evolution $U$ generated by $H(t/T)$ on $[0,T]$. By the chain rule,
$s\mapsto U(Ts)$ is generated by $TH$ on $[0,1]$, so it and $U(T)$ depend only on $TH$.

Reading the statement against the paper:
* `hU` says that `U` is the evolution of $H$ over time $T$:
  `IsEvolution (fun t ↦ H (t / T)) U 0 T`, generated by $H(t/T)$ on $[0,T]$.
* The conclusion is the chain-rule sentence: $TH$ (`fun s ↦ T • H s`) generates
  $s\mapsto U(Ts)$ on $[0,1]$, whose value at $s=1$ is $U(T)$. That $s\mapsto U(Ts)$ and $U(T)$
  depend only on $TH$ then follows from the uniqueness of evolutions
  (`exists_unique_evolution`, for regulated $TH$), which is not restated here. The rescaling of
  §4.2, that $U(T)$ "is also the final value of the evolution of $(T/N)H$ over time $N$", is
  `rescaled_evolution_steps`.
* No regularity hypothesis appears: the change of variable needs none.

The proof is `rescaled_evolution_steps` with $N=1$: the time change $t\mapsto Ts$. -/
theorem evolution_over_time {H U : ℝ → 𝕄} {T : ℝ} (hT : 0 < T)
    (hU : IsEvolution (fun t ↦ H (t / T)) U 0 T) :
    IsEvolution (fun s ↦ T • H s) (fun s ↦ U (T * s)) 0 1 := by
  simpa only [Nat.cast_one, div_one] using (rescaled_evolution_steps hT 1 one_pos hU).1

/-- Supports the interior-sample comparison: the right side of the interior-sample comparison(i)
with the two sizes $L\le h$ and $M=h$
is at most the right side with the one size $h$. -/
theorem unit_rhs_one_size {T N c₀ c₁ c₂ Nw Dw L h : ℝ} (hT : 0 ≤ T) (hN : 0 < N)
    (hc₀ : 0 ≤ c₀) (hc₂ : 0 ≤ c₂ + 2 * Dw) (hL0 : 0 ≤ L) (hLh : L ≤ h) :
    T / N ^ 2 * (2 * c₀ * L + (c₁ + Nw) * h + (c₂ + 2 * Dw) * T * L ^ 2 / N) ≤
      T / N ^ 2 * ((2 * c₀ + c₁ + Nw) * h + (c₂ + 2 * Dw) * T * h ^ 2 / N) := by
  have h1 : 2 * c₀ * L ≤ 2 * c₀ * h := mul_le_mul_of_nonneg_left hLh (by linarith)
  have h2 : (c₂ + 2 * Dw) * T * L ^ 2 / N ≤ (c₂ + 2 * Dw) * T * h ^ 2 / N :=
    div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hL0 hLh 2) (mul_nonneg hc₂ hT)) hN.le
  refine mul_le_mul_of_nonneg_left ?_ (div_nonneg hT (pow_nonneg hN.le 2))
  linarith [h1, h2]

/-- Supports the interior-sample comparison: its constants are nonnegative where the one-size
bound needs it,
$c_0=\mathcal N(w)-\mathcal N(w/2)/2\ge0$ and $c_2+2\mathcal N'(w)\ge0$ for $0\le w<2\pi$, with
$\mathcal N$ written as its series. -/
theorem unit_constants_nonneg {w : ℝ} (hw0 : 0 ≤ w) (hw : w < 2 * π) :
    let Nf : ℝ → ℝ := fun x ↦ ∑' n : ℕ+, 2 / (4 * π ^ 2 * (n : ℝ) ^ 2 - x ^ 2)
    0 ≤ Nf w - Nf (w / 2) / 2 ∧ 0 ≤ Nf w - Nf (w / 2) / 2 + 1 / 24 + 2 * deriv Nf w := by
  intro Nf
  rw [show Nf w = frameBound w from (paper_series_eq hw0 hw).1,
    show Nf (w / 2) = frameBound (w / 2) from
      (paper_series_eq (x := w / 2) (by linarith) (by linarith)).1,
    show deriv Nf w = frameLip w from (paper_series_eq hw0 hw).2]
  exact ⟨(walk_c0_bounds hw0 hw).1, by linarith [(walk_c0_bounds hw0 hw).1, frameLip_nonneg hw0]⟩

/-- **the interior-sample comparison** (the unit-step comparison theorem, one size). Let $0\le
w<2\pi$, and put
$c_0=\mathcal N(w)-\mathcal N(w/2)/2$ and $c_2=c_0+1/24$. The following hold for every $h$, every
Hamiltonian $H(s)$, $s\in[0,1]$, with $\|H'(s)\|\le h$ and $\|H'(s_1)-H'(s_2)\|\le h|s_1-s_2|$
for $s,s_1,s_2\in[0,1]$, every $T>0$, and every integer $N\ge2$ for which each sample
$(T/N)H(j/N)$, $0<j<N$, has eigenvalue differences of modulus at most $w$. Here $U$ is the
evolution of $H$ over time $T$ and $W_N$ is its $N$-step product (Definition 2.3).
(i) $\|W_N-e^{iTH(1)/(2N)}U(T)e^{-iTH(0)/(2N)}\|\le\frac T{N^2}\bigl((2c_0+\tfrac18+
\mathcal N(w))h+(c_2+2\mathcal N'(w))Th^2/N\bigr)$; (ii) the same distance is at most
$\frac T{N^2}$ times the end, residual and jump terms, $c_0(\|H'(\frac1N)\|+\|H'(1-\frac1N)\|)+
c_1\|H'\|_{\mathrm{Lip},N}+c_2\frac TN\|H'\|_{2,N}^2+\Sigma_N$.

Reading the statement against the comparison:
* The constants read as in `unit_step_comparison`: `Nf` is $\mathcal N$ written as its series,
  `c₁ = 1/8` is the $\tfrac18$ of (i), and the last clause gives $c_0$ at $w=\pi$.
* `hbd` is $\|H'(s)\|\le h$ and `hlip` is $\|H'(s_1)-H'(s_2)\|\le h|s_1-s_2|$ on $[0,1]$, with
  `derivWithin H (Icc 0 1)` for $H'$, the derivative in $s$ (§2: "Primes denote derivatives of a
  function in its own variable, $t$ on $[a,b]$ and $s$ on $[0,1]$, and derivatives of scalar
  functions"), one-sided at $0$ and $1$; `ContDiffOn ℝ 1 H` makes explicit
  what the comparison's $H'$ presupposes. No sign hypothesis on $h$ appears: `hbd` forces $h\ge0$.
* `hU` says that `U` is the evolution of $H$ over time $T$:
  `IsEvolution (fun t ↦ H (t / T)) U 0 T`. `(unitProduct (fun s ↦ (T / N) • H s) N).1` is
  $W_N$, and `evol (H 1) (-(T / (2 * N)))` is $e^{iTH(1)/(2N)}$.
* The width hypothesis is stated for the eigenvalues of $H(j/N)$ times $T/N>0$, which are the
  eigenvalues of $(T/N)H(j/N)$, for all pairs `p q` and $0<j<N$.
* `Hd`, `Yb`, `J` and the mesh norms of (ii) and (iii) read as in `unit_step_comparison`; `J` is
  $\Sigma_N$, reindexed.
* The two conjuncts are parts (i) and (ii), in this order. The bound on $\Sigma_N$ that the proof
  of (i) uses is `unit_step_sigma_bound` (`Comparison/SigmaBound.lean`).

The proof is `unit_step_comparison` with Lipschitz constant $M=h$: its (ii) is (ii) here, and
its (i), with $L=\max\|H'\|\le h$ (`unit_rhs_one_size`, using $c_0\ge0$ and
$c_2+2\mathcal N'(w)\ge0$ from `unit_constants_nonneg`), gives (i). -/
theorem unit_step_comparison_one_size [NeZero d] (w : ℝ) (hw : w < 2 * π) :
    let Nf : ℝ → ℝ := fun x ↦ ∑' n : ℕ+, 2 / (4 * π ^ 2 * (n : ℝ) ^ 2 - x ^ 2)
    ∃ c₀ c₁ c₂ : ℝ,
    (c₀ = Nf w - Nf (w / 2) / 2 ∧ c₁ = 1 / 8 ∧ c₂ = c₀ + 1 / 24 ∧
      (w = π → c₀ = (π - 2) / (2 * π ^ 2))) ∧
    ∀ (H U : ℝ → 𝕄) (T : ℝ) (N : ℕ) (_ : 0 < T) (_ : 2 ≤ N)
      (hH : ∀ s ∈ Icc (0 : ℝ) 1, (H s).IsHermitian)
      (_ : ContDiffOn ℝ 1 H (Icc (0 : ℝ) 1))
      (h : ℝ) (_ : ∀ s ∈ Icc (0 : ℝ) 1, ‖derivWithin H (Icc (0 : ℝ) 1) s‖ ≤ h)
      (_ : ∀ s ∈ Icc (0 : ℝ) 1, ∀ t ∈ Icc (0 : ℝ) 1,
        ‖derivWithin H (Icc (0 : ℝ) 1) t - derivWithin H (Icc (0 : ℝ) 1) s‖ ≤ h * |t - s|)
      (_ : ∀ j : ℕ, ∀ _hj : 0 < j, ∀ hjN : j < N, ∀ p q,
        (T / N) * |(hH _ (walkCubic_sample hjN.le)).eigenvalues p -
          (hH _ (walkCubic_sample hjN.le)).eigenvalues q| ≤ w)
      (_ : IsEvolution (fun t ↦ H (t / T)) U 0 T),
      let Hd := derivWithin H (Icc (0 : ℝ) 1)
      let Yb : ℝ → 𝕄 := fun s ↦ frameOp ((T / N) • H s) (Hd s)
      let J := ∑ j ∈ Finset.range (N - 2), ‖Yb ((j + 2 : ℕ) / N) - Yb ((j + 1 : ℕ) / N)‖
      ‖(unitProduct (fun s ↦ (T / N) • H s) N).1 -
        UnitaryProducts.evol (H 1) (-(T / (2 * N))) * U T *
          UnitaryProducts.evol (H 0) (T / (2 * N))‖ ≤
        T / N ^ 2 * ((2 * c₀ + c₁ + Nf w) * h + (c₂ + 2 * deriv Nf w) * T * h ^ 2 / N) ∧
      ‖(unitProduct (fun s ↦ (T / N) • H s) N).1 -
        UnitaryProducts.evol (H 1) (-(T / (2 * N))) * U T *
          UnitaryProducts.evol (H 0) (T / (2 * N))‖ ≤
        T / N ^ 2 * (c₀ * (‖Hd (1 / N)‖ + ‖Hd (1 - 1 / N)‖) +
          c₁ * (∑ j ∈ Finset.range N, lipOn Hd (meshInterval N j)) / N +
          c₂ * (T / N) * meshMoment Hd N 2 + J) := by
  intro Nf
  obtain ⟨c₀, c₁, c₂, hcs, hall⟩ := unit_step_comparison (d := d) w hw
  refine ⟨c₀, c₁, c₂, hcs, ?_⟩
  intro H U T N hT hN2 hH hc h hbd hlip hdiff hU Hd Yb J
  -- The norm bound implies w ≥ 0; no separate nonnegativity hypothesis is needed.
  have hw0 : 0 ≤ w := by simpa using hdiff 1 (by omega) (by omega) (0 : Fin d) 0
  have h0 : 0 ≤ h := (norm_nonneg _).trans (hbd 0 ⟨le_rfl, zero_le_one⟩)
  obtain ⟨h1, h2, -⟩ := hall H U T N hT hN2 hH hc h hlip hdiff hU
  have hL0 : 0 ≤ sSup ((fun s ↦ ‖Hd s‖) '' Icc (0 : ℝ) 1) :=
    Real.sSup_nonneg (by rintro _ ⟨s, _, rfl⟩; exact norm_nonneg _)
  have hLh : sSup ((fun s ↦ ‖Hd s‖) '' Icc (0 : ℝ) 1) ≤ h :=
    Real.sSup_le (by rintro _ ⟨s, hs, rfl⟩; exact hbd s hs) h0
  obtain ⟨hA, hB⟩ := unit_constants_nonneg hw0 hw
  have hnn : 0 ≤ c₀ := by rw [hcs.1]; exact hA
  have hc₂ : 0 ≤ c₂ + 2 * deriv Nf w := by rw [hcs.2.2.1, hcs.1]; exact hB
  have hNR : (0 : ℝ) < N := Nat.cast_pos.mpr (by omega)
  exact ⟨h1.trans (unit_rhs_one_size hT.le hNR hnn hc₂ hL0 hLh), h2⟩

/-- **the interior-sample leakage estimate** (two-sided leakage transfer, one size). Let $H$, $U$,
$W_N$, $T$, $N$, and
$w$ be as in the interior-sample comparison, and let $P$ and $Q$ be orthogonal projectors
commuting with $H(0)$ and
$H(1)$, respectively. Then $\bigl|\|(1-Q)W_NP\|-\|(1-Q)U(T)P\|\bigr|$ is at most the right side of
the interior-sample comparison(ii), and hence of (i).

Reading the statement against the comparison:
* The hypotheses, constants, `Hd`, `Yb`, `J`, and the mesh norms read as in
  `unit_step_comparison_one_size` (the interior-sample comparison); `W` is the $N$-step product
$W_N$.
* `P`, `Q` are any star projections (orthogonal projectors) commuting with $H(0)$, $H(1)$; no
  band, gap, or adiabatic theorem enters.
* The two conjuncts are the bounds by the right sides of the interior-sample comparison(ii) and
(i), in this order.
  Both directions of the transfer are the one absolute value.

The proof is `unit_step_leakage_transfer` with Lipschitz constant $M=h$: its first conjunct is
the first here, and its second, with $L=\max\|H'\|\le h$ (`unit_rhs_one_size`), gives the
second. -/
theorem unit_step_leakage_transfer_one_size [NeZero d] (w : ℝ) (hw : w < 2 * π) :
    let Nf : ℝ → ℝ := fun x ↦ ∑' n : ℕ+, 2 / (4 * π ^ 2 * (n : ℝ) ^ 2 - x ^ 2)
    ∃ c₀ c₁ c₂ : ℝ,
    (c₀ = Nf w - Nf (w / 2) / 2 ∧ c₁ = 1 / 8 ∧ c₂ = c₀ + 1 / 24 ∧
      (w = π → c₀ = (π - 2) / (2 * π ^ 2))) ∧
    ∀ (H U : ℝ → 𝕄) (T : ℝ) (N : ℕ) (_ : 0 < T) (_ : 2 ≤ N)
      (hH : ∀ s ∈ Icc (0 : ℝ) 1, (H s).IsHermitian)
      (_ : ContDiffOn ℝ 1 H (Icc (0 : ℝ) 1))
      (h : ℝ) (_ : ∀ s ∈ Icc (0 : ℝ) 1, ‖derivWithin H (Icc (0 : ℝ) 1) s‖ ≤ h)
      (_ : ∀ s ∈ Icc (0 : ℝ) 1, ∀ t ∈ Icc (0 : ℝ) 1,
        ‖derivWithin H (Icc (0 : ℝ) 1) t - derivWithin H (Icc (0 : ℝ) 1) s‖ ≤ h * |t - s|)
      (_ : ∀ j : ℕ, ∀ _hj : 0 < j, ∀ hjN : j < N, ∀ p q,
        (T / N) * |(hH _ (walkCubic_sample hjN.le)).eigenvalues p -
          (hH _ (walkCubic_sample hjN.le)).eigenvalues q| ≤ w)
      (_ : IsEvolution (fun t ↦ H (t / T)) U 0 T)
      (P Q : 𝕄) (_ : IsStarProjection P) (_ : IsStarProjection Q)
      (_ : Commute P (H 0)) (_ : Commute Q (H 1)),
      let Hd := derivWithin H (Icc (0 : ℝ) 1)
      let Yb : ℝ → 𝕄 := fun s ↦ frameOp ((T / N) • H s) (Hd s)
      let J := ∑ j ∈ Finset.range (N - 2), ‖Yb ((j + 2 : ℕ) / N) - Yb ((j + 1 : ℕ) / N)‖
      let W := (unitProduct (fun s ↦ (T / N) • H s) N).1
      |‖(1 - Q) * W * P‖ - ‖(1 - Q) * U T * P‖| ≤
        T / N ^ 2 * (c₀ * (‖Hd (1 / N)‖ + ‖Hd (1 - 1 / N)‖) +
          c₁ * (∑ j ∈ Finset.range N, lipOn Hd (meshInterval N j)) / N +
          c₂ * (T / N) * meshMoment Hd N 2 + J) ∧
      |‖(1 - Q) * W * P‖ - ‖(1 - Q) * U T * P‖| ≤
        T / N ^ 2 * ((2 * c₀ + c₁ + Nf w) * h + (c₂ + 2 * deriv Nf w) * T * h ^ 2 / N) := by
  intro Nf
  obtain ⟨c₀, c₁, c₂, hcs, hall⟩ := unit_step_leakage_transfer (d := d) w hw
  refine ⟨c₀, c₁, c₂, hcs, ?_⟩
  intro H U T N hT hN2 hH hc h hbd hlip hdiff hU P Q hP hQ hPc hQc Hd Yb J W
  -- The norm bound implies w ≥ 0; no separate nonnegativity hypothesis is needed.
  have hw0 : 0 ≤ w := by simpa using hdiff 1 (by omega) (by omega) (0 : Fin d) 0
  have h0 : 0 ≤ h := (norm_nonneg _).trans (hbd 0 ⟨le_rfl, zero_le_one⟩)
  obtain ⟨h1, h2⟩ := hall H U T N hT hN2 hH hc h hlip hdiff hU P Q hP hQ hPc hQc
  have hL0 : 0 ≤ sSup ((fun s ↦ ‖Hd s‖) '' Icc (0 : ℝ) 1) :=
    Real.sSup_nonneg (by rintro _ ⟨s, _, rfl⟩; exact norm_nonneg _)
  have hLh : sSup ((fun s ↦ ‖Hd s‖) '' Icc (0 : ℝ) 1) ≤ h :=
    Real.sSup_le (by rintro _ ⟨s, hs, rfl⟩; exact hbd s hs) h0
  obtain ⟨hA, hB⟩ := unit_constants_nonneg hw0 hw
  have hnn : 0 ≤ c₀ := by rw [hcs.1]; exact hA
  have hc₂ : 0 ≤ c₂ + 2 * deriv Nf w := by rw [hcs.2.2.1, hcs.1]; exact hB
  have hNR : (0 : ℝ) < N := Nat.cast_pos.mpr (by omega)
  exact ⟨h1, h2.trans (unit_rhs_one_size hT.le hNR hnn hc₂ hL0 hLh)⟩

/-- **the width-π scaling bound** (unit-step comparison, one size). Let $T>0$, let $H$ be a
Hamiltonian on $[0,1]$
with $\|H'(s)\|\le h$ and $\|H'(s_1)-H'(s_2)\|\le h|s_1-s_2|$, and let $U$ be its evolution over
time $T$. For integer $N\ge2$, if every interior sample $(T/N)H(j/N)$ has eigenvalue differences
of modulus at most $\pi$, then
$\|e^{-iTH(1)/(2N)}W_Ne^{iTH(0)/(2N)}-U(T)\|=O(Th/N^2+T^2h^2/N^3)$, with an absolute constant,
so at $N=T$ it is $O((h+h^2)/T)$.

Reading the statement against the comparison:
* This makes the asymptotic statement explicit: the $O(\cdot)$ is realized with the constants $2$
  and $1$, as the bound $2Th/N^2+T^2h^2/N^3$; the second conjunct is its value $(2h+h^2)/T$ at
  $N=T$, at most twice $(h+h^2)/T$.
* `derivWithin H (Icc 0 1)` is $H'$, one-sided at $0$ and $1$; `ContDiffOn ℝ 1 H` makes explicit
  what the comparison's $H'$ presupposes. No sign hypothesis on $h$ appears: $\|H'(s)\|\le h$ forces
  $h\ge0$.
* `evol G u` is $e^{-iuG}$, so `evol (H 1) (T / (2 * N))` is $e^{-iTH(1)/(2N)}$, and
  `(unitProduct (fun s ↦ (T / N) • H s) N).1` is $W_N$.
* `IsEvolution (fun t ↦ H (t / T)) U 0 T` says that `U` is the evolution of $H$ over time $T$.
* The width hypothesis is stated for the eigenvalues of $H(j/N)$ times $T/N>0$, which are the
  eigenvalues of $(T/N)H(j/N)$, for all pairs `p q` and $0<j<N$.
* `(N:ℝ) = T` is the comparison's "at $N=T$": $T$ is then a positive integer.

The proof is `unit_step_comparison_scaling` with Lipschitz constant $M=h$, whose bound
$\frac T{N^2}(L+M)+\frac{T^2}{N^3}L^2$ with $L=\max\|H'\|\le h$ is at most
$2Th/N^2+T^2h^2/N^3$; at $N=T$ this is $(2h+h^2)/T$. -/
theorem unit_step_comparison_scaling_one_size [NeZero d] :
    ∀ (H U : ℝ → 𝕄) (T : ℝ) (N : ℕ), 0 < T → 2 ≤ N →
    ∀ (hH : ∀ s ∈ Icc (0 : ℝ) 1, (H s).IsHermitian),
    ContDiffOn ℝ 1 H (Icc 0 1) →
    ∀ h : ℝ, (∀ s ∈ Icc (0 : ℝ) 1, ‖derivWithin H (Icc (0 : ℝ) 1) s‖ ≤ h) →
    (∀ s ∈ Icc (0 : ℝ) 1, ∀ t ∈ Icc (0 : ℝ) 1,
      ‖derivWithin H (Icc (0 : ℝ) 1) t - derivWithin H (Icc (0 : ℝ) 1) s‖ ≤ h * |t - s|) →
    (∀ j : ℕ, 0 < j → ∀ hjN : j < N, ∀ p q,
      T / N * |(hH _ (unit_sample_mem hjN)).eigenvalues p -
        (hH _ (unit_sample_mem hjN)).eigenvalues q| ≤ π) →
    IsEvolution (fun t ↦ H (t / T)) U 0 T →
    ‖UnitaryProducts.evol (H 1) (T / (2 * N)) * (unitProduct (fun s ↦ (T / N) • H s) N).1 *
        UnitaryProducts.evol (H 0) (-(T / (2 * N))) - U T‖ ≤
      2 * T * h / N ^ 2 + T ^ 2 * h ^ 2 / N ^ 3 ∧
    ((N : ℝ) = T →
      ‖UnitaryProducts.evol (H 1) (T / (2 * N)) * (unitProduct (fun s ↦ (T / N) • H s) N).1 *
        UnitaryProducts.evol (H 0) (-(T / (2 * N))) - U T‖ ≤ (2 * h + h ^ 2) / T) := by
  intro H U T N hT hN2 hH hc h hbd hlip hdiff hU
  have h0 : 0 ≤ h := (norm_nonneg _).trans (hbd 0 ⟨le_rfl, zero_le_one⟩)
  have hb := unit_step_comparison_scaling H U T N hT hN2 hH hc h hlip hdiff hU
  dsimp only at hb
  have hL0 : 0 ≤ sSup ((fun s ↦ ‖derivWithin H (Icc (0 : ℝ) 1) s‖) '' Icc (0 : ℝ) 1) :=
    Real.sSup_nonneg (by rintro _ ⟨s, _, rfl⟩; exact norm_nonneg _)
  have hLh : sSup ((fun s ↦ ‖derivWithin H (Icc (0 : ℝ) 1) s‖) '' Icc (0 : ℝ) 1) ≤ h :=
    Real.sSup_le (by rintro _ ⟨s, hs, rfl⟩; exact hbd s hs) h0
  have hNR : (0 : ℝ) < N := Nat.cast_pos.mpr (by omega)
  have hscale := unit_rhs_one_size (T := T) (N := (N : ℝ))
    (c₀ := 1 / 2) (c₁ := 1) (Nw := 0) (c₂ := 1) (Dw := 0)
    hT.le hNR (by norm_num) (by norm_num) hL0 hLh
  have hmain : _ ≤ 2 * T * h / N ^ 2 + T ^ 2 * h ^ 2 / N ^ 3 :=
    hb.trans (by convert hscale using 1 <;> ring)
  refine ⟨hmain, fun hNT ↦ hmain.trans_eq ?_⟩
  rw [hNT]
  field_simp

/-- A supporting one-size walk comparison. the walk comparison states the separate-coefficient
form proved by `UnitaryProducts.Prose.walk_comparison_jrs`. Let $W$ and $\Lambda$ be as in
Lemma A.2, and let $h$ bound $\|W'\|$ and $\|W''\|$ on $[0,1]$. For every integer $T\ge2$, with
$U_\Lambda$ the evolution of $\Lambda$ over time $T$,
$\|W_T-e^{i\Lambda(1)/2}U_\Lambda(T)e^{-i\Lambda(0)/2}\|\le c(\vartheta)(2h+h^2)/T$, where
$c(\vartheta)=(\frac18+\mathcal N(w))/\cos^2(w/4)+c_2S^2+\eta$, with $c_2$ as in the
interior-sample comparison and
$\eta$ as in the spectral comparison, and $c(\vartheta)\sim(3\pi+4+8/\pi)/\vartheta^3$ as
$\vartheta\to0$.

Reading the statement against the comparison:
* The walk hypotheses, $\Lambda$, $c(\vartheta)$ (`walkConstantChord (2 * π - w)`), the "where"
  clause, and the limit read as in `unit_step_walk_comparison_chord`.
* `hbd1` and `hbd2` say that $h$ bounds $\|W'\|$ and $\|W''\|$ on $[0,1]$, with one-sided
  derivatives at $0$ and $1$. No sign hypothesis on $h$ appears: `hbd1` forces $h\ge0$.
* `IsEvolution (fun t ↦ Λ (t / T)) U 0 T` says that `U` is $U_\Lambda$, the evolution of $\Lambda$
  over time $T$; `evol (Λ 1) (-(1 / 2))` is $e^{i\Lambda(1)/2}$, `evol (Λ 0) (1 / 2)` is
  $e^{-i\Lambda(0)/2}$, and `(walk W T).2` is $W_T$.

The proof is `unit_step_walk_comparison_chord`, whose bound is $c(\vartheta)(L+M+L^2)/T$ with
$L=\max\|W'\|\le h$ and $M=\max\|W''\|\le h$; as $c(\vartheta)\ge0$, it is at most
$c(\vartheta)(2h+h^2)/T$. -/
theorem unit_step_walk_comparison_one_size [NeZero d] (a : ℝ → ℝ) (w : ℝ)
    (hw : w < 2 * π) (W : ℝ → 𝕄)
    (ha : ContinuousOn a (Icc (0 : ℝ) 1))
    (hunit : (walk W 1).1)
    (harc : ∀ s ∈ Icc (0 : ℝ) 1, ∀ z ∈ spectrum ℂ (W s),
      ∃ θ ∈ Icc (a s) (a s + w), z = Complex.exp (-I * (θ : ℂ)))
    (hc : ContDiffOn ℝ 2 W (Icc (0 : ℝ) 1)) (h : ℝ)
    (hbd1 : ∀ s ∈ Icc (0 : ℝ) 1, ‖derivWithin W (Icc (0 : ℝ) 1) s‖ ≤ h)
    (hbd2 : ∀ s ∈ Icc (0 : ℝ) 1,
      ‖derivWithin (derivWithin W (Icc (0 : ℝ) 1)) (Icc 0 1) s‖ ≤ h) :
    let N : ℝ → ℝ := fun x ↦ ∑' n : ℕ+, 2 / (4 * π ^ 2 * (n : ℝ) ^ 2 - x ^ 2)
    let S : ℝ → ℝ := fun x ↦ if x = 0 then 1 else (x / 2) / Real.sin (x / 2)
    (∃ Λ : ℝ → 𝕄, ∃ hΛ : ∀ s ∈ Icc (0 : ℝ) 1, (Λ s).IsHermitian,
      (∀ s (hs : s ∈ Icc (0 : ℝ) 1),
        (∀ i, (hΛ s hs).eigenvalues i ∈ Icc (a s) (a s + w)) ∧ evol (Λ s) 1 = W s) ∧
      ContDiffOn ℝ 2 Λ (Icc (0 : ℝ) 1) ∧
      ∀ T : ℕ, 2 ≤ T → ∀ U : ℝ → 𝕄, IsEvolution (fun t ↦ Λ (t / T)) U 0 T →
        ‖(walk W T).2 - evol (Λ 1) (-(1 / 2)) * U T * evol (Λ 0) (1 / 2)‖ ≤
          walkConstantChord (2 * π - w) * (2 * h + h ^ 2) / T) ∧
    walkConstantChord (2 * π - w) =
      (1 / 8 + N w) / Real.cos (w / 4) ^ 2 + (N w - N (w / 2) / 2 + 1 / 24) * (S w) ^ 2 +
      2 * S w * (S (w / 2) * deriv N w + 2 * S w * ∫ t in (0 : ℝ)..1, deriv N (t * w)) ∧
    Tendsto (fun ϑ ↦ walkConstantChord ϑ * ϑ ^ 3) (𝓝[>] 0) (𝓝 (3 * π + 4 + 8 / π)) := by
  intro N S
  obtain ⟨⟨Λ, hΛ, he, hc2, hcmp⟩, hwhere, hlim⟩ :=
    unit_step_walk_comparison_chord a w hw W ha hunit harc hc
  refine ⟨⟨Λ, hΛ, he, hc2, fun T hT U hU ↦ (hcmp T hT U hU).trans ?_⟩, hwhere, hlim⟩
  -- The norm bound implies w ≥ 0; no separate nonnegativity hypothesis is needed.
  have hw0 : 0 ≤ w := by have hh := (he 0 ⟨le_rfl, zero_le_one⟩).1 0; linarith [hh.1, hh.2]
  have h0 : 0 ≤ h := (norm_nonneg _).trans (hbd1 0 ⟨le_rfl, zero_le_one⟩)
  have hL0 : 0 ≤ sSup ((fun s ↦ ‖derivWithin W (Icc (0 : ℝ) 1) s‖) '' Icc (0 : ℝ) 1) :=
    Real.sSup_nonneg (by rintro _ ⟨s, _, rfl⟩; exact norm_nonneg _)
  have hLh : sSup ((fun s ↦ ‖derivWithin W (Icc (0 : ℝ) 1) s‖) '' Icc (0 : ℝ) 1) ≤ h :=
    Real.sSup_le (by rintro _ ⟨s, hs, rfl⟩; exact hbd1 s hs) h0
  have hMh : sSup ((fun s ↦ ‖derivWithin (derivWithin W (Icc (0 : ℝ) 1)) (Icc 0 1) s‖) ''
      Icc (0 : ℝ) 1) ≤ h :=
    Real.sSup_le (by rintro _ ⟨s, hs, rfl⟩; exact hbd2 s hs) h0
  have hval : walkConstantChord (2 * π - w) = walkUnitCoefficientChord w := by
    rw [walkConstantChord_eq, sub_sub_cancel]
  have hK0 : 0 ≤ walkConstantChord (2 * π - w) := by
    rw [hval, walkUnitCoefficientChord]
    have hn0 := frameBound_nonneg hw0
    have hc0 : 0 ≤ frameBound w - frameBound (w / 2) / 2 :=
      (norm_nonneg _).trans (norm_frameSeries_sub_half_le (a := (0 : ℂ)) (w := w)
        (by simpa only [norm_zero] using hw0) hw)
    exact add_nonneg (add_nonneg (mul_nonneg (by linarith only [hn0]) (sq_nonneg _))
      (mul_nonneg (by linarith only [hc0]) (sq_nonneg _))) (walkFrameSharp_nonneg hw0 hw)
  have hTR : (0 : ℝ) < T := Nat.cast_pos.mpr (by omega)
  have hsum : sSup ((fun s ↦ ‖derivWithin W (Icc (0 : ℝ) 1) s‖) '' Icc (0 : ℝ) 1) +
      sSup ((fun s ↦ ‖derivWithin (derivWithin W (Icc (0 : ℝ) 1)) (Icc 0 1) s‖) ''
        Icc (0 : ℝ) 1) +
      sSup ((fun s ↦ ‖derivWithin W (Icc (0 : ℝ) 1) s‖) '' Icc (0 : ℝ) 1) ^ 2 ≤
        2 * h + h ^ 2 :=
    (add_le_add (add_le_add hLh hMh) (pow_le_pow_left₀ hL0 hLh 2)).trans_eq (by ring)
  exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hsum hK0) hTR.le

end UnitaryProducts.Paper
