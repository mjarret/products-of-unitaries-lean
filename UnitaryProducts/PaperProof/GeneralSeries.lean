attribute [local instance] matrixCStarAlgebra
/-- The noncommutative power derivative on an inner derivation telescopes.
Each summand is the difference of two adjacent terms. -/
theorem cubicPowDerivative_inner {A : Type*} [NormedRing A] (a b : A) (n : ℕ) :
    cubicPowDerivative a (a * b - b * a) n = a ^ n * b - b * a ^ n := by
  let f : ℕ → A := fun j ↦ a ^ (n - j) * b * a ^ j
  have hterm (j : ℕ) (hj : j ∈ Finset.range n) :
      a ^ (n - 1 - j) * (a * b - b * a) * a ^ j = f j - f (j + 1) := by
    have hjn := Finset.mem_range.mp hj
    have hleft : n - j = (n - 1 - j) + 1 := by omega
    have hright : n - (j + 1) = n - 1 - j := by omega
    dsimp only [f]
    rw [hleft, hright, pow_succ a (n - 1 - j), pow_succ' a j]
    noncomm_ring
  rw [cubicPowDerivative, Finset.sum_congr rfl hterm, Finset.sum_range_sub']
  simp [f]

variable {d : ℕ}
local notation "𝕄" => Matrix (Fin d) (Fin d) ℂ

/-- The finite insertion sum in the paper's order, with all `n` insertions. -/
theorem cubicPowDerivative_outer_sum (Ω A D : 𝕄) (n : ℕ) :
    cubicPowDerivative (adL Ω) (adL A) n D =
      ∑ k ∈ Finset.range n, (adL Ω ^ k) (adL A ((adL Ω ^ (n - 1 - k)) D)) := by
  simp only [cubicPowDerivative, ContinuousLinearMap.sum_apply,
    ContinuousLinearMap.mul_apply]
  rw [← Finset.sum_range_reflect
    (fun k ↦ (adL Ω ^ k) (adL A ((adL Ω ^ (n - 1 - k)) D))) n]
  apply Finset.sum_congr rfl
  intro k hk
  have hk' : k ≤ n - 1 := by have := Finset.mem_range.mp hk; omega
  simp only [Nat.sub_sub_self hk']

/-- Jacobi's identity identifies the insertion generated by `[Ω,B]` with
an operator commutator. -/
theorem adL_commutator (Ω B : 𝕄) :
    adL (adL Ω B) = adL Ω * adL B - adL B * adL Ω := by
  apply ContinuousLinearMap.ext
  intro D
  simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.mul_apply, adL_apply]
  noncomm_ring

/-- The two surviving terms in the finite Jacobi telescope in Lemma A.3. -/
theorem cubicPowDerivative_commutator_telescope (Ω B D : 𝕄) (n : ℕ) :
    cubicPowDerivative (adL Ω) (adL (adL Ω B)) n D =
      (adL Ω ^ n) (adL B D) - adL B ((adL Ω ^ n) D) := by
  rw [adL_commutator, cubicPowDerivative_inner]
  rfl

/-- Each individual insertion in the positive-coefficient series of Lemma A.3
has the displayed bound, before summing the `n` terms. -/
theorem norm_ad_insertion_le [NeZero d] {Ω : 𝕄}
    (hΩ : Ω.IsHermitian) {w : ℝ} (hw0 : 0 ≤ w)
    (hwidth : ∀ p q, |hΩ.eigenvalues p - hΩ.eigenvalues q| ≤ w)
    (A D : 𝕄) {n k : ℕ} (hk : k < n) {ν : ℝ} (hν : 0 ≤ ν) :
    ‖(ν : ℂ) • ((adL Ω ^ k) (adL A ((adL Ω ^ (n - 1 - k)) D)))‖ ≤
      2 * ν * w ^ (n - 1) * ‖A‖ * ‖D‖ := by
  have hp (m : ℕ) (X : 𝕄) : ‖(adL Ω ^ m) X‖ ≤ w ^ m * ‖X‖ :=
    (ContinuousLinearMap.le_opNorm _ _).trans
      (mul_le_mul_of_nonneg_right (ad_power_norm_le hΩ hwidth m) (norm_nonneg _))
  have ha : ‖adL A‖ ≤ 2 * ‖A‖ := by
    have h := norm_I_smul_adL_le A 0
    simpa only [norm_smul, Complex.norm_I, one_mul, zero_smul, sub_zero] using h
  have hmiddle (X : 𝕄) : ‖adL A X‖ ≤ 2 * ‖A‖ * ‖X‖ :=
    (ContinuousLinearMap.le_opNorm _ _).trans
      (mul_le_mul_of_nonneg_right ha (norm_nonneg _))
  rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hν]
  calc
    _ ≤ ν * (w ^ k * (2 * ‖A‖ * (w ^ (n - 1 - k) * ‖D‖))) := by
      gcongr
      exact (hp k _).trans (mul_le_mul_of_nonneg_left
        ((hmiddle _).trans (mul_le_mul_of_nonneg_left (hp (n - 1 - k) D)
          (by positivity))) (pow_nonneg hw0 _))
    _ = 2 * ν * (w ^ k * w ^ (n - 1 - k)) * ‖A‖ * ‖D‖ := by ring
    _ = _ := by rw [← pow_add, show k + (n - 1 - k) = n - 1 by omega]

/-- Each of the `n` insertions is bounded with the spectral midpoint shift estimate
on the outer and inner powers and the elementary commutator estimate. -/
theorem norm_cubicPowDerivative_ad_le [NeZero d] {Ω : 𝕄}
    (hΩ : Ω.IsHermitian) {w : ℝ} (hw0 : 0 ≤ w)
    (hwidth : ∀ p q, |hΩ.eigenvalues p - hΩ.eigenvalues q| ≤ w)
    (A D : 𝕄) (n : ℕ) :
    ‖cubicPowDerivative (adL Ω) (adL A) n D‖ ≤
      2 * n * w ^ (n - 1) * ‖A‖ * ‖D‖ := by
  rw [cubicPowDerivative_outer_sum]
  calc
    _ ≤ ∑ k ∈ Finset.range n,
        ‖(adL Ω ^ k) (adL A ((adL Ω ^ (n - 1 - k)) D))‖ := norm_sum_le _ _
    _ ≤ ∑ _k ∈ Finset.range n, 2 * w ^ (n - 1) * ‖A‖ * ‖D‖ := by
      apply Finset.sum_le_sum
      intro k hk
      simpa only [Complex.ofReal_one, one_smul, mul_one] using
        norm_ad_insertion_le hΩ hw0 hwidth A D (Finset.mem_range.mp hk) zero_le_one
    _ = _ := by simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]; ring

/-- The paper's assumptions on the coefficients of `g`. -/
structure NonnegativeSeries (c : ℕ → ℝ) : Prop where
  nonneg : ∀ n, 0 ≤ c n
  converges : ∀ r : ℝ, 0 ≤ r → r < 2 * π → Summable (fun n ↦ c n * r ^ n)

/-- The scalar function represented by the coefficients. -/
def scalarSeries (c : ℕ → ℝ) (x : ℝ) : ℝ := ∑' n, c n * x ^ n

/-- The same coefficients evaluated in a complex Banach algebra. -/
def algebraSeries {A : Type*} [NormedRing A] [NormedAlgebra ℂ A]
    (c : ℕ → ℝ) (a : A) : A := ∑' n, (c n : ℂ) • a ^ n

/-- The derivative coefficient series converges throughout the original open disc.
This is the standard differentiation theorem for locally uniformly convergent
holomorphic series, applied to scalar monomials. -/
theorem NonnegativeSeries.summable_derivative {c : ℕ → ℝ} (hc : NonnegativeSeries c)
    {r : ℝ} (hr0 : 0 ≤ r) (hr : r < 2 * π) :
    Summable (fun n ↦ c n * n * r ^ (n - 1)) := by
  let R := (r + 2 * π) / 2
  have hrR : r < R := by dsimp [R]; linarith
  have hR : R < 2 * π := by dsimp [R]; linarith
  have hR0 : 0 ≤ R := hr0.trans hrR.le
  have hd (n : ℕ) (z : ℂ) : HasDerivAt (fun z : ℂ ↦ (c n : ℂ) * z ^ n)
      ((c n : ℂ) * n * z ^ (n - 1)) z := by
    convert ((hasDerivAt_id z).pow n).const_mul (c n : ℂ) using 1; simp [mul_assoc]
  have hs := Complex.hasSum_deriv_of_summable_norm (hc.converges R hR0 hR)
    (F := fun n z ↦ (c n : ℂ) * z ^ n) (U := Metric.ball 0 R)
    (fun n z _ ↦ (hd n z).differentiableAt.differentiableWithinAt)
    Metric.isOpen_ball (fun n z hz ↦ ?_) (z := (r : ℂ)) ?_
  · have hs' := Complex.reCLM.summable hs.summable
    simpa only [(hd _ _).deriv, Complex.reCLM_apply, Complex.mul_re, Complex.ofReal_re,
      Complex.natCast_re,
      Complex.ofReal_im, Complex.natCast_im, zero_mul, mul_zero, sub_zero,
      ← Complex.ofReal_pow] using hs'
  · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hc.nonneg n), norm_pow]
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg z)
      (mem_ball_zero_iff.mp hz).le n) (hc.nonneg n)
  · simpa only [mem_ball_zero_iff, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr0]
      using hrR

section BanachAlgebra
variable {A : Type*} [NormedRing A] [NormedAlgebra ℂ A] [CompleteSpace A] [NormOneClass A]

omit [CompleteSpace A] in
/-- Absolute convergence of the algebra-valued series inside the prescribed radius. -/
theorem NonnegativeSeries.summable_norm {c : ℕ → ℝ} (hc : NonnegativeSeries c)
    {a : A} {r : ℝ} (ha : ‖a‖ ≤ r) (hr : r < 2 * π) :
    Summable (fun n ↦ ‖(c n : ℂ) • a ^ n‖) := by
  apply Summable.of_nonneg_of_le (fun _ ↦ norm_nonneg _)
    (fun n ↦ ?_) (hc.converges r ((norm_nonneg a).trans ha) hr)
  rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hc.nonneg n)]
  exact mul_le_mul_of_nonneg_left ((norm_pow_le a n).trans
    (pow_le_pow_left₀ (norm_nonneg a) ha n)) (hc.nonneg n)

/-- The generic series is analytic, hence smooth, on the open convergence ball. -/
theorem NonnegativeSeries.analytic {c : ℕ → ℝ} (hc : NonnegativeSeries c) :
    AnalyticOnNhd ℂ (algebraSeries c : A → A) (Metric.ball 0 (2 * π)) := by
  apply analyticOnNhd_tsum_coeff (by positivity)
  intro r hr0 hr
  simpa only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hc.nonneg _)] using
    hc.converges r hr0 hr

/-- Differentiate the algebra series in an arbitrary, possibly noncommuting direction. -/
theorem NonnegativeSeries.hasDerivAt_line {c : ℕ → ℝ} (hc : NonnegativeSeries c)
    {a b : A} (ha : ‖a‖ < 2 * π) :
    HasDerivAt (fun z : ℂ ↦ algebraSeries c (a + z • b))
      (∑' n, (c n : ℂ) • cubicPowDerivative a b n) 0 := by
  let r : ℝ := (‖a‖ + 2 * π) / 2
  have hra : ‖a‖ < r := by dsimp [r]; linarith
  have hr : r < 2 * π := by dsimp [r]; linarith
  have hr0 : 0 ≤ r := (norm_nonneg a).trans hra.le
  let δ : ℝ := (r - ‖a‖) / (‖b‖ + 1)
  have hb1 : 0 < ‖b‖ + 1 := by positivity
  have hδ : 0 < δ := div_pos (sub_pos.mpr hra) hb1
  have hab (z : ℂ) (hz : z ∈ Metric.ball 0 δ) : ‖a + z • b‖ ≤ r := by
    have hzn : ‖z‖ < (r - ‖a‖) / (‖b‖ + 1) := mem_ball_zero_iff.mp hz
    have hle : ‖z‖ * ‖b‖ ≤ ‖z‖ * (‖b‖ + 1) :=
      mul_le_mul_of_nonneg_left (by linarith) (norm_nonneg z)
    linarith [norm_add_le a (z • b), norm_smul z b, (lt_div_iff₀ hb1).mp hzn]
  have hline (z : ℂ) : HasDerivAt (fun y : ℂ ↦ a + y • b) b z := by
    simpa using ((hasDerivAt_id z).smul_const b).const_add a
  have hd := hasDerivAt_tsum_of_isPreconnected
    (u := fun n ↦ (c n * n * r ^ (n - 1)) * ‖b‖)
    (g := fun n z ↦ (c n : ℂ) • (a + z • b) ^ n)
    (g' := fun n z ↦ (c n : ℂ) • cubicPowDerivative (a + z • b) b n)
    ((hc.summable_derivative hr0 hr).mul_right ‖b‖)
    Metric.isOpen_ball (convex_ball (0 : ℂ) δ).isPreconnected
    (fun n z _ ↦ ?_) (fun n z hz ↦ ?_)
    (y₀ := (0 : ℂ)) (Metric.mem_ball_self hδ) ?_ (Metric.mem_ball_self hδ)
  · simpa only [zero_smul, add_zero, algebraSeries] using hd
  · simpa only [cubicPowDerivative, Nat.pred_eq_sub_one] using
      ((hline z).fun_pow' n).const_smul (c n : ℂ)
  · rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hc.nonneg n)]
    exact (mul_le_mul_of_nonneg_left (norm_cubicPowDerivative_le (hab z hz) n)
      (hc.nonneg n)).trans_eq (by ring)
  · simpa only [zero_smul, add_zero] using (hc.summable_norm le_rfl ha).of_norm

/-- The algebra-valued chain rule for a real parameter, including endpoints. -/
theorem NonnegativeSeries.hasDerivWithinAt_comp {c : ℕ → ℝ} (hc : NonnegativeSeries c)
    {f : ℝ → A} {fd : A} {S : Set ℝ} {s : ℝ}
    (hf : HasDerivWithinAt f fd S s) (ha : ‖f s‖ < 2 * π) :
    HasDerivWithinAt (fun t ↦ algebraSeries c (f t))
      (∑' n, (c n : ℂ) • cubicPowDerivative (f s) fd n) S s := by
  have hdiff := (hc.analytic (A := A) _ (mem_ball_zero_iff.mpr ha)).differentiableAt
  have hline : HasDerivAt (fun z : ℂ ↦ f s + z • fd) fd 0 := by
    simpa using ((hasDerivAt_id (0 : ℂ)).smul_const fd).const_add (f s)
  have hbase : HasFDerivAt (algebraSeries c : A → A)
      (fderiv ℂ (algebraSeries c) (f s)) (f s + (0 : ℂ) • fd) := by
    simpa only [zero_smul, add_zero] using hdiff.hasFDerivAt
  have hcomp := hbase.comp_hasDerivAt 0 hline
  have hvalue := hcomp.unique (hc.hasDerivAt_line (b := fd) ha)
  simpa only [← hvalue] using
    (hdiff.hasFDerivAt.restrictScalars ℝ).comp_hasDerivWithinAt s hf
omit [CompleteSpace A] in
/-- Absolute convergence of the noncommutative derivative series. -/
theorem NonnegativeSeries.summable_norm_derivative {c : ℕ → ℝ}
    (hc : NonnegativeSeries c) {a b : A} {r : ℝ}
    (ha : ‖a‖ ≤ r) (hr : r < 2 * π) :
    Summable (fun n ↦ ‖(c n : ℂ) • cubicPowDerivative a b n‖) := by
  apply Summable.of_nonneg_of_le (fun _ ↦ norm_nonneg _) (fun n ↦ ?_)
    ((hc.summable_derivative ((norm_nonneg a).trans ha) hr).mul_right ‖b‖)
  rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hc.nonneg n)]
  exact (mul_le_mul_of_nonneg_left (norm_cubicPowDerivative_le ha n)
    (hc.nonneg n)).trans_eq (by ring)

end BanachAlgebra
section BanachSpace
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  [CompleteSpace E] [Nontrivial E]
/-- Smoothness of series evaluation composed with a linear map and an input. -/
theorem NonnegativeSeries.contDiffAt_apply {c : ℕ → ℝ} (hc : NonnegativeSeries c)
    (L : E →L[ℂ] (E →L[ℂ] E)) (a b : E) (ha : ‖L a‖ < 2 * π) :
    ContDiffAt ℂ 1 (fun p : E × E ↦ algebraSeries c (L p.1) p.2) (a, b) := by
  have hs : ContDiffAt ℂ 1 (algebraSeries c : (E →L[ℂ] E) → (E →L[ℂ] E)) (L a) :=
    (hc.analytic _ (mem_ball_zero_iff.mpr ha)).contDiffAt
  have hl : ContDiffAt ℂ 1 (fun p : E × E ↦ L p.1) (a, b) :=
    L.contDiff.contDiffAt.comp (a, b) contDiffAt_fst
  exact (hs.comp (a, b) hl).clm_apply contDiffAt_snd
end BanachSpace

/-- The scalar derivative of `g` is its differentiated coefficient series. -/
theorem NonnegativeSeries.hasDerivAt_scalar {c : ℕ → ℝ} (hc : NonnegativeSeries c)
    {r : ℝ} (hr0 : 0 ≤ r) (hr : r < 2 * π) :
    HasDerivAt (scalarSeries c) (∑' n, c n * n * r ^ (n - 1)) r := by
  have ha : ‖(r : ℂ)‖ < 2 * π := by
    simpa only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr0] using hr
  have hd := (hc.hasDerivWithinAt_comp
    (hasDerivAt_ofReal r).hasDerivWithinAt (S := univ) ha).hasDerivAt (by simp)
  have hp (n : ℕ) : cubicPowDerivative (r : ℂ) 1 n = n * (r : ℂ) ^ (n - 1) := by
    have h := (hasDerivAt_id (r : ℂ)).fun_pow' n
    simpa only [cubicPowDerivative, Nat.pred_eq_sub_one, mul_one] using
      h.unique ((hasDerivAt_id (r : ℂ)).pow n)
  have he (x : ℝ) : algebraSeries c (x : ℂ) = (scalarSeries c x : ℂ) := by
    simp only [algebraSeries, scalarSeries, Complex.ofReal_tsum, Complex.ofReal_mul,
      Complex.ofReal_pow, smul_eq_mul]
  have hd' : HasDerivAt (fun x ↦ (scalarSeries c x : ℂ))
      ((∑' n, c n * n * r ^ (n - 1) : ℝ) : ℂ) r := by
    simpa only [he, hp, Complex.ofReal_tsum, Complex.ofReal_mul, Complex.ofReal_natCast,
      Complex.ofReal_pow, smul_eq_mul, mul_assoc] using hd
  exact (Complex.reCLM.hasFDerivAt.comp_hasDerivAt r hd')

/-- Applying `g` to the commutator operator, as in the appendix opening. -/
def commutatorSeries (c : ℕ → ℝ) (Ω D : 𝕄) : 𝕄 := algebraSeries c (adL Ω) D

/-- The operator-algebra sum and the paper's matrix-valued series agree. -/
theorem commutatorSeries_eq_tsum [NeZero d] {c : ℕ → ℝ} (hc : NonnegativeSeries c)
    (Ω D : 𝕄) (ha : ‖adL Ω‖ < 2 * π) :
    commutatorSeries c Ω D = ∑' n, (c n : ℂ) • (adL Ω ^ n) D := by
  have hs : Summable (fun n : ℕ ↦ (c n : ℂ) • adL Ω ^ n) :=
    (hc.summable_norm (A := 𝕄 →L[ℂ] 𝕄) (a := adL Ω) le_rfl ha).of_norm
  rw [commutatorSeries, algebraSeries, tsum_apply_of_summable hs]
  simp only [ContinuousLinearMap.smul_apply]

/-- Equation `eq:series-bound`, for every power series specified in the appendix. -/
theorem general_series_bound [NeZero d] {c : ℕ → ℝ} (hc : NonnegativeSeries c)
    {Ω : 𝕄} (hΩ : Ω.IsHermitian) {w : ℝ} (hw0 : 0 ≤ w) (hw : w < 2 * π)
    (hwidth : ∀ p q, |hΩ.eigenvalues p - hΩ.eigenvalues q| ≤ w) (D : 𝕄) :
    ‖commutatorSeries c Ω D‖ ≤ scalarSeries c w * ‖D‖ := by
  have ha : ‖adL Ω‖ ≤ w := by
    simpa only [pow_one] using UnitStepsProse.ad_power_norm_le hΩ hwidth 1
  have hb (n : ℕ) : ‖(c n : ℂ) • (adL Ω ^ n) D‖ ≤ (c n * w ^ n) * ‖D‖ := by
    rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hc.nonneg n)]
    have hp := (ContinuousLinearMap.le_opNorm (adL Ω ^ n) D).trans
      (mul_le_mul_of_nonneg_right (UnitStepsProse.ad_power_norm_le hΩ hwidth n)
        (norm_nonneg D))
    exact (mul_le_mul_of_nonneg_left hp (hc.nonneg n)).trans_eq (by ring)
  have hs := (hc.converges w hw0 hw).mul_right ‖D‖
  have hn := Summable.of_nonneg_of_le (fun _ ↦ norm_nonneg _) hb hs
  rw [commutatorSeries_eq_tsum hc Ω D (ha.trans_lt hw)]
  exact (norm_tsum_le_tsum_norm hn).trans
    ((hn.tsum_le_tsum hb hs).trans_eq (tsum_mul_right))

/-- Coefficients of `g(x)-g(0)`, retaining the original degree indexing. -/
def withoutConstant (c : ℕ → ℝ) (n : ℕ) : ℝ := if n = 0 then 0 else c n

/-- Removing the constant preserves nonnegativity and the convergence radius. -/
theorem NonnegativeSeries.withoutConstant {c : ℕ → ℝ} (hc : NonnegativeSeries c) :
    NonnegativeSeries (withoutConstant c) where
  nonneg := fun n ↦ by
    simp only [UnitaryProducts.PaperProof.withoutConstant]
    split_ifs
    · exact le_rfl
    · exact hc.nonneg n
  converges := by
    intro r hr0 hr
    apply Summable.of_nonneg_of_le (fun n ↦ ?_) (fun n ↦ ?_) (hc.converges r hr0 hr)
    · have hn : 0 ≤ UnitaryProducts.PaperProof.withoutConstant c n := by
        simp only [UnitaryProducts.PaperProof.withoutConstant]
        split_ifs
        · exact le_rfl
        · exact hc.nonneg n
      exact mul_nonneg hn (pow_nonneg hr0 n)
    · dsimp only [UnitaryProducts.PaperProof.withoutConstant]
      split_ifs
      · exact (by simpa using mul_nonneg (hc.nonneg n) (pow_nonneg hr0 n))
      · exact le_rfl

/-- The scalar value after removing degree zero is exactly `g(w)-g(0)`. -/
theorem scalarSeries_withoutConstant {c : ℕ → ℝ} (hc : NonnegativeSeries c)
    {w : ℝ} (hw0 : 0 ≤ w) (hw : w < 2 * π) :
    scalarSeries (withoutConstant c) w = scalarSeries c w - c 0 := by
  have he := (hc.converges w hw0 hw).tsum_eq_add_tsum_ite 0
  have ht : (fun n ↦ withoutConstant c n * w ^ n) =
      (fun n ↦ if n = 0 then 0 else c n * w ^ n) := by
    funext n
    simp only [UnitaryProducts.PaperProof.withoutConstant]
    split_ifs <;> simp_all
  unfold scalarSeries
  rw [ht]
  simpa only [pow_zero, mul_one, eq_sub_iff_add_eq, add_comm] using he.symm

/-- Removing degree zero from the operator series subtracts the scalar identity term. -/
theorem commutatorSeries_withoutConstant [NeZero d] {c : ℕ → ℝ}
    (hc : NonnegativeSeries c) (Ω D : 𝕄) (ha : ‖adL Ω‖ < 2 * π) :
    commutatorSeries (withoutConstant c) Ω D = commutatorSeries c Ω D - (c 0 : ℂ) • D := by
  have hs : Summable (fun n : ℕ ↦ (c n : ℂ) • (adL Ω ^ n) D) := by
    have hop := (hc.summable_norm (A := 𝕄 →L[ℂ] 𝕄) (a := adL Ω) le_rfl ha).of_norm
    simpa only [ContinuousLinearMap.apply_apply, ContinuousLinearMap.smul_apply] using
      (ContinuousLinearMap.apply ℂ 𝕄 D).summable hop
  have he := hs.tsum_eq_add_tsum_ite 0
  rw [commutatorSeries_eq_tsum hc.withoutConstant Ω D ha,
    commutatorSeries_eq_tsum hc Ω D ha]
  have ht : (fun n ↦ (withoutConstant c n : ℂ) • (adL Ω ^ n) D) =
      (fun n ↦ if n = 0 then 0 else (c n : ℂ) • (adL Ω ^ n) D) := by
    funext n
    simp only [UnitaryProducts.PaperProof.withoutConstant]
    split_ifs <;> simp_all
  rw [ht, eq_sub_iff_add_eq]
  simpa only [pow_zero, ContinuousLinearMap.one_apply, add_comm] using he.symm

/-- Termwise differentiation in equation `eq:series-derivative`, with independent
`C¹` generator and input curves and one-sided endpoint derivatives. -/
theorem general_series_derivative [NeZero d] {c : ℕ → ℝ} (hc : NonnegativeSeries c)
    {Ω D : ℝ → 𝕄} {Ωd Dd : 𝕄} {S : Set ℝ} {s : ℝ}
    (hΩ : HasDerivWithinAt Ω Ωd S s) (hD : HasDerivWithinAt D Dd S s)
    (ha : ‖adL (Ω s)‖ < 2 * π) :
    HasDerivWithinAt (fun t ↦ commutatorSeries c (Ω t) (D t))
      (commutatorSeries c (Ω s) Dd + ∑' n, (c n : ℂ) •
        (∑ k ∈ Finset.range n, (adL (Ω s) ^ k)
          (adL Ωd ((adL (Ω s) ^ (n - 1 - k)) (D s))))) S s := by
  have hA := hasDerivWithinAt_complex_clm_comp (E := 𝕄) (F := 𝕄 →L[ℂ] 𝕄) (adLCLM d) hΩ
  change HasDerivWithinAt (fun t ↦ adL (Ω t)) (adL Ωd) S s at hA
  have hd := hasDerivWithinAt_complex_clm_apply (E := 𝕄) (F := 𝕄)
    (hc.hasDerivWithinAt_comp hA ha) hD
  have hs := (hc.summable_norm_derivative (b := adL Ωd) le_rfl ha).of_norm
  rw [tsum_apply_of_summable hs] at hd
  simp only [ContinuousLinearMap.smul_apply] at hd
  simp_rw [cubicPowDerivative_outer_sum] at hd
  simpa only [commutatorSeries, add_comm] using hd

/-- The norm estimate in equation `eq:series-derivative` for independent paths. -/
theorem general_series_derivative_bound [NeZero d] {c : ℕ → ℝ}
    (hc : NonnegativeSeries c) {Ω D : ℝ → 𝕄} {Ωd Dd : 𝕄} {S : Set ℝ} {s : ℝ}
    (hΩd : HasDerivWithinAt Ω Ωd S s) (hDd : HasDerivWithinAt D Dd S s)
    (hu : UniqueDiffWithinAt ℝ S s) (hΩ : (Ω s).IsHermitian)
    {w : ℝ} (hw0 : 0 ≤ w) (hw : w < 2 * π)
    (hwidth : ∀ p q, |hΩ.eigenvalues p - hΩ.eigenvalues q| ≤ w) :
    ‖derivWithin (fun t ↦ commutatorSeries c (Ω t) (D t)) S s‖ ≤
      scalarSeries c w * ‖Dd‖ + 2 * deriv (scalarSeries c) w * ‖Ωd‖ * ‖D s‖ := by
  have ha : ‖adL (Ω s)‖ < 2 * π := by
    exact (show ‖adL (Ω s)‖ ≤ w by
      simpa only [pow_one] using UnitStepsProse.ad_power_norm_le hΩ hwidth 1).trans_lt hw
  let f : ℕ → 𝕄 := fun n ↦ (c n : ℂ) •
    cubicPowDerivative (adL (Ω s)) (adL Ωd) n (D s)
  let u : ℕ → ℝ := fun n ↦ (c n * n * w ^ (n - 1)) * (2 * ‖Ωd‖ * ‖D s‖)
  have huSum : Summable u := (hc.summable_derivative hw0 hw).mul_right _
  have hb (n : ℕ) : ‖f n‖ ≤ u n := by
    dsimp only [f]
    rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hc.nonneg n)]
    exact (mul_le_mul_of_nonneg_left (norm_cubicPowDerivative_ad_le hΩ hw0 hwidth Ωd (D s) n)
      (hc.nonneg n)).trans_eq (by dsimp [u]; ring)
  have hn := Summable.of_nonneg_of_le (fun _ ↦ norm_nonneg _) hb huSum
  have he : ‖∑' n, f n‖ ≤ 2 * deriv (scalarSeries c) w * ‖Ωd‖ * ‖D s‖ := by
    apply (norm_tsum_le_tsum_norm hn).trans
    apply (hn.tsum_le_tsum hb huSum).trans_eq
    dsimp only [u]
    rw [tsum_mul_right, (hc.hasDerivAt_scalar hw0 hw).deriv]
    ring
  rw [(general_series_derivative hc hΩd hDd ha).derivWithin hu]
  simp_rw [← cubicPowDerivative_outer_sum]
  exact (norm_add_le _ _).trans
    (add_le_add (general_series_bound hc hΩ hw0 hw hwidth Dd) he)

/-- Continuous differentiability of equation `eq:series-derivative`: analytic
power-series evaluation composed with two arbitrary `C¹` paths. -/
theorem general_series_contDiffOn [NeZero d] {c : ℕ → ℝ} (hc : NonnegativeSeries c)
    {Ω D : ℝ → 𝕄} {S : Set ℝ} {w : ℝ} (hw : w < 2 * π)
    (hΩ : ∀ s ∈ S, (Ω s).IsHermitian)
    (hwidth : ∀ s (hs : s ∈ S), ∀ p q,
      |(hΩ s hs).eigenvalues p - (hΩ s hs).eigenvalues q| ≤ w)
    (hcΩ : ContDiffOn ℝ 1 Ω S) (hcD : ContDiffOn ℝ 1 D S) :
    ContDiffOn ℝ 1 (fun s ↦ commutatorSeries c (Ω s) (D s)) S := by
  intro s hs
  have ha : ‖adL (Ω s)‖ < 2 * π := by
    exact (show ‖adL (Ω s)‖ ≤ w by
      simpa only [pow_one] using UnitStepsProse.ad_power_norm_le (hΩ s hs)
        (hwidth s hs) 1).trans_lt hw
  have hlocal := (hc.contDiffAt_apply (adLCLM d) (Ω s) (D s) ha).restrict_scalars ℝ
  exact hlocal.comp_contDiffWithinAt s ((hcΩ.prodMk hcD) s hs)

/-- The series and entrywise interpretations of an arbitrary `g` agree in
any unitary eigenbasis, as asserted immediately after `eq:series-bound`. -/
theorem general_series_eigenbasis_entry [NeZero d] {c : ℕ → ℝ}
    (hc : NonnegativeSeries c) (Ω D : 𝕄) (ha : ‖adL Ω‖ < 2 * π)
    (U : Matrix.unitaryGroup (Fin d) ℂ) (ev : Fin d → ℝ)
    (hdiag : star (U : 𝕄) * Ω * (U : 𝕄) = Matrix.diagonal (fun p ↦ (ev p : ℂ)))
    (p q : Fin d) :
    (star (U : 𝕄) * commutatorSeries c Ω D * (U : 𝕄)) p q =
      (scalarSeries c (ev p - ev q) : ℂ) * (star (U : 𝕄) * D * (U : 𝕄)) p q := by
  have hs : Summable (fun n : ℕ ↦ (c n : ℂ) • adL Ω ^ n) :=
    (hc.summable_norm (A := 𝕄 →L[ℂ] 𝕄) (a := adL Ω) le_rfl ha).of_norm
  have hsD := (ContinuousLinearMap.apply ℂ 𝕄 D).summable hs
  have he := ((entryCLM p q).comp
    (ContinuousLinearMap.mulLeftRight ℂ 𝕄 (star (U : 𝕄)) (U : 𝕄))).map_tsum hsD
  simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.mulLeftRight_apply,
    ContinuousLinearMap.apply_apply,
    show ∀ X : 𝕄, entryCLM p q X = X p q from fun _ ↦ rfl] at he
  rw [commutatorSeries_eq_tsum hc Ω D ha, scalarSeries,
    Complex.ofReal_tsum, ← tsum_mul_right]
  erw [he]
  apply tsum_congr
  intro n
  simp only [ContinuousLinearMap.smul_apply, Matrix.mul_smul, Matrix.smul_mul,
    Matrix.smul_apply, smul_eq_mul, Complex.ofReal_mul, Complex.ofReal_pow]
  rw [ad_power_arbitrary_eigenbasis_entry Ω D U ev hdiag]
  ring

end UnitaryProducts.PaperProof
